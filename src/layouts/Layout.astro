---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import { ClientRouter } from 'astro:transitions';
import { businessInfo } from '../data/business';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  currentPath?: string;
  pageType?: 'website' | 'article' | 'localBusiness';
  breadcrumbs?: { name: string; url: string }[];
  citySpecific?: 'malang' | 'kediri';
  showCTA?: boolean;
}

const {
  title = 'Event Organizer Malang & Kediri | Aethel Event Studio',
  description = 'Jasa Event Organizer profesional di Malang & Kediri untuk Corporate Event, Wedding, Seminar, Gathering, dan Festival musik dengan manajemen terpadu.',
  keywords = 'Event Organizer Malang, Jasa EO Malang, Event Organizer Kediri, Jasa EO di Kediri, EO Corporate Malang, Wedding Organizer Malang',
  image = '/images/hero-stage.jpg',
  currentPath = Astro.url.pathname,
  breadcrumbs = [],
  citySpecific,
  showCTA = true,
} = Astro.props;

const siteUrl = 'https://eventorganizermalang-kediri.com';
const canonicalURL = new URL(currentPath, siteUrl).href;
const fullImageUrl = new URL(image, siteUrl).href;

// JSON-LD Structured Data
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: businessInfo.name,
  legalName: businessInfo.legalName,
  url: siteUrl,
  logo: `${siteUrl}/images/client-portrait.jpg`,
  description: businessInfo.shortDesc,
  email: businessInfo.email,
  telephone: businessInfo.phone,
  areaServed: businessInfo.areasServed.map((area) => ({
    '@type': 'Place',
    name: area,
  })),
  sameAs: [
    businessInfo.socials.instagram,
    businessInfo.socials.tiktok,
    businessInfo.socials.youtube,
    businessInfo.socials.linkedin,
  ],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `${businessInfo.name} ${citySpecific ? (citySpecific === 'malang' ? 'Malang' : 'Kediri') : 'Malang & Kediri'}`,
  description: description,
  url: canonicalURL,
  telephone: businessInfo.phone,
  email: businessInfo.email,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: citySpecific === 'kediri' 
      ? 'Jl. Dhoho No. 88, Pakelan' 
      : 'Jl. Besar Ijen No. 42, Klojen',
    addressLocality: citySpecific === 'kediri' ? 'Kediri' : 'Malang',
    addressRegion: 'Jawa Timur',
    postalCode: citySpecific === 'kediri' ? '64129' : '65115',
    addressCountry: 'ID',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '18:00',
    },
  ],
};

const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((bc, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: bc.name,
    item: new URL(bc.url, siteUrl).href,
  })),
} : null;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={businessInfo.name} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={businessInfo.name} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageUrl} />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='25' fill='%232d553b'/><path d='M30 20 L50 75 L70 20' stroke='%23e8f0e9' stroke-width='10' fill='none'/></svg>" />

    <!-- Astro View Transitions for Buttery Smooth Page Navigation -->
    <ClientRouter />
  </head>
  
  <body class="bg-white text-[#1a251e] flex flex-col min-h-screen selection:bg-[#396947] selection:text-white overflow-x-hidden">
    <Header currentPath={currentPath} />

    <main class="flex-grow animate-page-enter">
      <slot />
    </main>

    <!-- Floating Action Buttons: Back to Top & WhatsApp -->
    <aside aria-label="Aksi Cepat" class="fixed bottom-6 right-6 z-40 flex flex-col items-center gap-3">
      <!-- Button On Top (Scroll To Top) -->
      <button
        id="back-to-top"
        type="button"
        aria-label="Kembali ke atas"
        title="Kembali ke atas"
        class="w-11 h-11 sm:w-12 sm:h-12 bg-white text-[#1b3825] hover:bg-[#2d553b] hover:text-white border border-[#d6e4d9] rounded-full shadow-lg hover:shadow-xl transition-all duration-300 flex items-center justify-center cursor-pointer hover:scale-110 opacity-0 pointer-events-none translate-y-3 group"
      >
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </button>

      <!-- Floating WhatsApp Logo Button -->
      <a
        href={`https://wa.me/${businessInfo.whatsapp}?text=Halo%20Aethel%20Events,%20saya%20ingin%20berkonsultasi%20tentang%20rencana%20acara.`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Hubungi kami via WhatsApp"
        title="Chat WhatsApp"
        class="w-13 h-13 sm:w-14 sm:h-14 bg-[#25D366] hover:bg-[#20ba59] text-white rounded-full shadow-xl hover:shadow-2xl transition-all duration-300 flex items-center justify-center cursor-pointer hover:scale-110 border-2 border-white group relative animate-float"
      >
        <span class="absolute -top-0.5 -right-0.5 flex h-3.5 w-3.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-300 border-2 border-white"></span>
        </span>
        <svg class="w-7 h-7 sm:w-8 sm:h-8 fill-current" viewBox="0 0 24 24">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zM12.05 20.2c-1.5 0-2.97-.4-4.26-1.16l-.31-.18-3.16.83.84-3.08-.2-.32a8.21 8.21 0 01-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 012.41 5.83c.02 4.54-3.68 8.24-8.38 8.24zm4.51-6.17c-.25-.12-1.47-.72-1.7-.8-.23-.09-.39-.13-.56.12-.17.25-.64.8-.79.97-.14.17-.29.19-.54.07-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.23.9 2.43 1.02 2.6.13.16 1.77 2.7 4.29 3.79.6.26 1.07.41 1.44.53.6.19 1.15.16 1.59.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.28z"/>
        </svg>
      </a>
    </aside>

    {showCTA && <CTASection />}

    <Footer />

    <!-- Scroll Reveal & Back To Top Scripts -->
    <script>
      function setupScrollReveal() {
        const reveals = document.querySelectorAll('.reveal-on-scroll');
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                obs.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.12,
            rootMargin: '0px 0px -40px 0px'
          });

          reveals.forEach(el => observer.observe(el));
        } else {
          reveals.forEach(el => el.classList.add('is-revealed'));
        }
      }

      function setupBackToTop() {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;

        function toggleVisibility() {
          if (window.scrollY > 250) {
            btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
            btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
          } else {
            btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
            btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
          }
        }

        window.addEventListener('scroll', toggleVisibility, { passive: true });
        toggleVisibility();

        btn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });
      }

      // Initial run & re-run after view transitions
      document.addEventListener('DOMContentLoaded', () => {
        setupScrollReveal();
        setupBackToTop();
      });
      document.addEventListener('astro:page-load', () => {
        setupScrollReveal();
        setupBackToTop();
      });
    </script>
  </body>
</html>
