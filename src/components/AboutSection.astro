---
import { businessInfo } from '../data/business';
---

<section class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 reveal-on-scroll">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
    
    <!-- Left Column: Story & Value Propositions -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Main Heading -->
      <h2 class="text-2xl sm:text-4xl lg:text-[2.6rem] font-extrabold text-[#1b3825] leading-tight tracking-tight">
        Wujudkan Momen Istimewa dengan <span class="text-[#2d553b] italic font-normal">Kreativitas, Presisi,</span> & Dedikasi Penuh.
      </h2>

      <!-- Narrative Text -->
      <p class="text-sm sm:text-base text-[#4d6653] leading-relaxed">
        <strong>{businessInfo.legalName}</strong> adalah perusahaan Event Organizer profesional yang berbasis di Malang dan Kediri. Kami hadir untuk menghilangkan kecemasan perencanaan acara, mulai dari koordinasi venue di Kota Wisata Batu, Konferensi Nasional di Malang, hingga Wedding & Gala Dinner megah di Kediri.
      </p>

      <!-- 3 Key Value Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-2">
        
        <div class="p-4 rounded-2xl bg-white border border-[#e2ece4] shadow-xs hover:border-[#2d553b]/40 transition-colors">
          <div class="w-9 h-9 rounded-xl bg-[#eaf4ec] text-[#2d553b] flex items-center justify-center mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xs sm:text-sm font-bold text-[#1b3825] mb-1">Presisi & SOP Ketat</h3>
          <p class="text-[11px] text-[#5a7461] leading-relaxed">Rundown presisi detik demi detik dengan tim lapangan tersertifikasi.</p>
        </div>

        <div class="p-4 rounded-2xl bg-white border border-[#e2ece4] shadow-xs hover:border-[#2d553b]/40 transition-colors">
          <div class="w-9 h-9 rounded-xl bg-[#eaf4ec] text-[#2d553b] flex items-center justify-center mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xs sm:text-sm font-bold text-[#1b3825] mb-1">Transparansi Biaya</h3>
          <p class="text-[11px] text-[#5a7461] leading-relaxed">Rincian anggaran terbuka tanpa mark-up atau biaya siluman.</p>
        </div>

        <div class="p-4 rounded-2xl bg-white border border-[#e2ece4] shadow-xs hover:border-[#2d553b]/40 transition-colors">
          <div class="w-9 h-9 rounded-xl bg-[#eaf4ec] text-[#2d553b] flex items-center justify-center mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
          </div>
          <h3 class="text-xs sm:text-sm font-bold text-[#1b3825] mb-1">2 Kantor Fisik</h3>
          <p class="text-[11px] text-[#5a7461] leading-relaxed">Kantor pusat di Malang & hub operasional di Kediri siap dikunjungi.</p>
        </div>

      </div>

      <!-- Action Links -->
      <div class="flex flex-wrap items-center gap-3.5 pt-2">
        <a
          href="/tentang-kami"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#2d553b] hover:bg-[#1f3f2a] text-white text-xs sm:text-sm font-semibold transition-all shadow-sm hover:shadow-md hover:scale-102"
        >
          <span>Pelajari Profil Kami</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href="/kontak"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#f0f6f1] hover:bg-[#e2ece4] text-[#2d553b] text-xs sm:text-sm font-semibold transition-all hover:scale-102"
        >
          <span>Konsultasi Rencana Acara</span>
        </a>
      </div>

    </div>

    <!-- Right Column: Clean Visual Photo Composition -->
    <div class="lg:col-span-5 relative">
      
      <!-- Background Ambient Glow -->
      <div class="absolute -inset-4 bg-gradient-to-tr from-[#2d553b]/10 to-transparent rounded-[3rem] blur-2xl -z-10"></div>

      <!-- Main Event Photo Card -->
      <div class="relative rounded-[2.5rem] overflow-hidden border border-[#e2ece4] shadow-lg bg-gray-100 group">
        <img
          src="/images/corporate-malang.webp"
          alt="Tim Event Organizer Aethel menyelenggarakan acara di Malang dan Kediri"
          class="w-full h-[360px] sm:h-[420px] object-cover group-hover:scale-105 transition-transform duration-700"
          loading="lazy"
          decoding="async"
          width="1000"
          height="747"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#112418]/80 via-transparent to-transparent"></div>

        <!-- In-Photo Caption -->
        <div class="absolute bottom-6 left-6 right-6 text-white">
          <h3 class="text-base font-bold leading-snug">
            Dedikasi Menghidupkan Setiap Konsep Acara Anda
          </h3>
          <p class="text-xs text-emerald-100/80 mt-1">
            Pengalaman produksi acara profesional di Malang, Batu, dan Kediri
          </p>
        </div>
      </div>

    </div>

  </div>
</section>
