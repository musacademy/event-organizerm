---
interface Props {
  totalCount: number;
}

const { totalCount } = Astro.props;
---

<aside class="w-full">
  <!-- Desktop Sticky Filter Card -->
  <div class="bg-white rounded-3xl p-6 border border-[#e2ece4] shadow-xs">
    
    <!-- Filter Header -->
    <div class="flex items-center justify-between pb-4 mb-5 border-b border-[#eef4f0]">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-[#2d553b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        <span class="text-sm font-extrabold text-[#1b3825]">Filter Event</span>
      </div>
      <button
        id="reset-filter-btn"
        type="button"
        class="text-xs font-semibold text-[#2d553b] hover:text-[#1b3825] hover:underline cursor-pointer"
      >
        Reset Semua
      </button>
    </div>

    <!-- 1. Search Box -->
    <div class="mb-6">
      <label for="event-search-input" class="block text-xs font-bold text-[#1b3825] mb-2">
        Cari Nama Event / Lokasi
      </label>
      <div class="relative">
        <input
          type="text"
          id="event-search-input"
          placeholder="Cari konser, run, festival..."
          class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-[#d6e3d9] bg-[#fbfdfb] text-gray-800 placeholder-gray-400 focus:outline-hidden focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] transition-all"
        />
        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    <!-- 2. Kategori Filter (Radio / Chips) -->
    <div class="mb-6">
      <span class="block text-xs font-bold text-[#1b3825] mb-2.5">
        Kategori Acara
      </span>
      <div class="space-y-1.5" id="category-filter-group">
        <label class="flex items-center justify-between p-2 rounded-xl hover:bg-[#f2f7f3] transition-colors cursor-pointer text-xs font-medium text-gray-700">
          <div class="flex items-center gap-2">
            <input type="radio" name="filter-category" value="all" checked class="accent-[#2d553b] text-[#2d553b]" />
            <span>Semua Kategori</span>
          </div>
          <span class="text-[10px] bg-[#eef4ef] text-[#2d553b] px-2 py-0.5 rounded-full font-bold" id="badge-count-all">
            {totalCount}
          </span>
        </label>

        <label class="flex items-center justify-between p-2 rounded-xl hover:bg-[#f2f7f3] transition-colors cursor-pointer text-xs font-medium text-gray-700">
          <div class="flex items-center gap-2">
            <input type="radio" name="filter-category" value="konser" class="accent-[#2d553b] text-[#2d553b]" />
            <span>Konser Musik</span>
          </div>
          <span class="text-[10px] text-gray-400">Live Gig</span>
        </label>

        <label class="flex items-center justify-between p-2 rounded-xl hover:bg-[#f2f7f3] transition-colors cursor-pointer text-xs font-medium text-gray-700">
          <div class="flex items-center gap-2">
            <input type="radio" name="filter-category" value="running" class="accent-[#2d553b] text-[#2d553b]" />
            <span>Running & Sport</span>
          </div>
          <span class="text-[10px] text-gray-400">Marathon</span>
        </label>

        <label class="flex items-center justify-between p-2 rounded-xl hover:bg-[#f2f7f3] transition-colors cursor-pointer text-xs font-medium text-gray-700">
          <div class="flex items-center gap-2">
            <input type="radio" name="filter-category" value="festival" class="accent-[#2d553b] text-[#2d553b]" />
            <span>Festival & Karnaval</span>
          </div>
          <span class="text-[10px] text-gray-400">Kuliner & Seni</span>
        </label>

        <label class="flex items-center justify-between p-2 rounded-xl hover:bg-[#f2f7f3] transition-colors cursor-pointer text-xs font-medium text-gray-700">
          <div class="flex items-center gap-2">
            <input type="radio" name="filter-category" value="expo" class="accent-[#2d553b] text-[#2d553b]" />
            <span>Expo & Pameran</span>
          </div>
          <span class="text-[10px] text-gray-400">Showcase</span>
        </label>
      </div>
    </div>

    <!-- 3. Kota / Wilayah Filter -->
    <div class="mb-6 pt-5 border-t border-[#eef4f0]">
      <span class="block text-xs font-bold text-[#1b3825] mb-2.5">
        Wilayah / Kota
      </span>
      <div class="grid grid-cols-2 gap-1.5" id="city-filter-group">
        <button
          type="button"
          class="city-filter-btn active py-1.5 px-3 rounded-xl text-xs font-bold bg-[#2d553b] text-white transition-all cursor-pointer text-center"
          data-city="all"
        >
          Semua
        </button>
        <button
          type="button"
          class="city-filter-btn py-1.5 px-3 rounded-xl text-xs font-medium bg-[#f2f7f3] hover:bg-[#e4ede6] text-[#344d3b] transition-all cursor-pointer text-center"
          data-city="malang"
        >
          Malang
        </button>
        <button
          type="button"
          class="city-filter-btn py-1.5 px-3 rounded-xl text-xs font-medium bg-[#f2f7f3] hover:bg-[#e4ede6] text-[#344d3b] transition-all cursor-pointer text-center"
          data-city="kediri"
        >
          Kediri
        </button>
        <button
          type="button"
          class="city-filter-btn py-1.5 px-3 rounded-xl text-xs font-medium bg-[#f2f7f3] hover:bg-[#e4ede6] text-[#344d3b] transition-all cursor-pointer text-center"
          data-city="batu"
        >
          Kota Batu
        </button>
      </div>
    </div>

    <!-- 4. Status Pendaftaran Filter -->
    <div class="mb-6 pt-5 border-t border-[#eef4f0]">
      <span class="block text-xs font-bold text-[#1b3825] mb-2.5">
        Status Pendaftaran
      </span>
      <div class="space-y-1.5">
        <label class="flex items-center gap-2 text-xs font-medium text-gray-700 cursor-pointer">
          <input type="checkbox" name="filter-status" value="pendaftaran-dibuka" class="accent-[#2d553b] rounded-sm" />
          <span>Pendaftaran Dibuka</span>
        </label>
        <label class="flex items-center gap-2 text-xs font-medium text-gray-700 cursor-pointer">
          <input type="checkbox" name="filter-status" value="early-bird-aktif" class="accent-[#2d553b] rounded-sm" />
          <span>Early Bird Aktif</span>
        </label>
        <label class="flex items-center gap-2 text-xs font-medium text-gray-700 cursor-pointer">
          <input type="checkbox" name="filter-status" value="slot-terbatas" class="accent-[#2d553b] rounded-sm" />
          <span>Slot Terbatas</span>
        </label>
      </div>
    </div>

    <!-- 5. Opsi Tiket Gratis / Berbayar -->
    <div class="pt-5 border-t border-[#eef4f0]">
      <span class="block text-xs font-bold text-[#1b3825] mb-2.5">
        Tipe Tiket
      </span>
      <div class="grid grid-cols-2 gap-1.5" id="price-filter-group">
        <button
          type="button"
          class="price-filter-btn active py-1.5 px-3 rounded-xl text-xs font-bold bg-[#2d553b] text-white transition-all cursor-pointer text-center"
          data-price="all"
        >
          Semua
        </button>
        <button
          type="button"
          class="price-filter-btn py-1.5 px-3 rounded-xl text-xs font-medium bg-[#f2f7f3] hover:bg-[#e4ede6] text-[#344d3b] transition-all cursor-pointer text-center"
          data-price="free"
        >
          Gratis (Free)
        </button>
      </div>
    </div>

  </div>

  <!-- Promotional Banner Below Sidebar (Desktop Only) -->
  <div class="hidden lg:block bg-gradient-to-br from-[#1b3825] to-[#2d553b] text-white rounded-3xl p-6 mt-6 shadow-sm">
    <div class="w-8 h-8 rounded-full bg-emerald-400/20 text-emerald-300 flex items-center justify-center mb-3">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
      </svg>
    </div>
    <h3 class="text-sm font-bold mb-1.5">Ingin Bikin Event Sendiri?</h3>
    <p class="text-xs text-[#cfe2d4] leading-relaxed mb-4">
      Kami melayani promotor konser musik, race management running event, expo hingga festival di Malang & Kediri.
    </p>
    <a
      href="/kontak"
      class="block text-center py-2.5 px-4 rounded-xl bg-white text-[#1b3825] font-bold text-xs hover:bg-[#eaf3ec] transition-colors"
    >
      Konsultasi EO Sekarang
    </a>
  </div>
</aside>
