---
import type { EventItem } from '../../data/events';
import { businessInfo } from '../../data/business';

interface Props {
  event: EventItem;
}

const { event } = Astro.props;
const isRunningEvent = event.categorySlug === 'running';
---

<!-- Registration Modal Backdrop & Container -->
<div
  id="event-reg-modal"
  class="fixed inset-0 z-100 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reg-modal-title"
>
  <div class="relative w-full max-w-xl bg-white rounded-3xl shadow-2xl overflow-hidden my-8 border border-[#e2ece4] transition-all transform animate-in fade-in zoom-in-95 duration-200">
    
    <!-- Modal Header -->
    <div class="p-5 sm:p-6 bg-[#1b3825] text-white flex items-start justify-between relative">
      <div>
        <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#3f724f] text-white uppercase tracking-wider mb-1.5">
          Formulir Pendaftaran
        </span>
        <h3 id="reg-modal-title" class="text-lg sm:text-xl font-bold font-sans text-white leading-snug">
          {event.title}
        </h3>
        <p class="text-xs text-[#b8d6bf] mt-1 flex items-center gap-1.5">
          <span>📅 {event.date}</span>
          <span>&bull;</span>
          <span>📍 {event.cityName}</span>
        </p>
      </div>

      <button
        id="close-reg-modal"
        type="button"
        class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors cursor-pointer shrink-0 ml-3"
        aria-label="Tutup Formulir"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Form Body -->
    <div id="modal-form-wrapper" class="p-6 max-h-[75vh] overflow-y-auto">
      <form id="event-reg-form" class="space-y-5">
        
        <!-- 1. Pilihan Kategori Tiket -->
        <div>
          <label class="block text-xs font-bold text-[#1b3825] mb-2">
            Pilih Kategori Tiket / Peserta <span class="text-rose-500">*</span>
          </label>
          <div class="space-y-2">
            {event.ticketTiers.map((tier, idx) => (
              <label class="flex items-start gap-3 p-3 rounded-2xl border border-[#dce8df] hover:border-[#2d553b] hover:bg-[#f7faf8] transition-all cursor-pointer has-checked:border-[#2d553b] has-checked:bg-[#edf4ee] has-checked:ring-1 has-checked:ring-[#2d553b]">
                <input
                  type="radio"
                  name="ticket_tier"
                  value={tier.name}
                  data-price={tier.price}
                  data-name={tier.name}
                  checked={idx === 0}
                  class="mt-1 accent-[#2d553b]"
                />
                <div class="flex-1">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-[#1b3825]">{tier.name}</span>
                    <span class="text-xs font-extrabold text-[#2d553b]">{tier.priceDisplay}</span>
                  </div>
                  <ul class="mt-1 space-y-0.5">
                    {tier.benefits.map((b) => (
                      <li class="text-[11px] text-[#526a58] flex items-center gap-1">
                        <span class="text-emerald-600 font-bold">✓</span> {b}
                      </li>
                    ))}
                  </ul>
                </div>
              </label>
            ))}
          </div>
        </div>

        <!-- 2. Jumlah Tiket -->
        <div class="p-3.5 bg-[#f4f8f5] rounded-2xl flex items-center justify-between border border-[#e1ece3]">
          <div>
            <span class="text-xs font-bold text-[#1b3825] block">Jumlah Tiket / Peserta</span>
            <span class="text-[10px] text-[#657d6d]">Maksimal 10 tiket per transaksi</span>
          </div>
          <div class="flex items-center gap-3">
            <button
              type="button"
              id="qty-minus"
              class="w-7 h-7 rounded-lg bg-white border border-[#c8dcd0] text-[#1b3825] font-bold text-sm flex items-center justify-center hover:bg-[#edf4ee] transition-colors cursor-pointer"
            >
              -
            </button>
            <span id="qty-val" class="text-sm font-extrabold text-[#1b3825] w-6 text-center">1</span>
            <button
              type="button"
              id="qty-plus"
              class="w-7 h-7 rounded-lg bg-white border border-[#c8dcd0] text-[#1b3825] font-bold text-sm flex items-center justify-center hover:bg-[#edf4ee] transition-colors cursor-pointer"
            >
              +
            </button>
          </div>
        </div>

        <!-- 3. Form Data Pemesan -->
        <div class="space-y-3.5 pt-2">
          <div>
            <label for="reg-name" class="block text-xs font-bold text-[#1b3825] mb-1">
              Nama Lengkap Pemesan / Perwakilan <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="reg-name"
              required
              placeholder="Contoh: Budi Santoso"
              class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-[#d6e3d9] bg-[#fbfdfb] text-gray-800 placeholder-gray-400 focus:outline-hidden focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] transition-all"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label for="reg-phone" class="block text-xs font-bold text-[#1b3825] mb-1">
                Nomor WhatsApp (Aktif) <span class="text-rose-500">*</span>
              </label>
              <input
                type="tel"
                id="reg-phone"
                required
                placeholder="Contoh: 088989643555"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-[#d6e3d9] bg-[#fbfdfb] text-gray-800 placeholder-gray-400 focus:outline-hidden focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] transition-all"
              />
              <span class="text-[10px] text-gray-400 block mt-0.5">E-ticket & konfirmasi dikirim ke nomor ini</span>
            </div>

            <div>
              <label for="reg-email" class="block text-xs font-bold text-[#1b3825] mb-1">
                Alamat Email <span class="text-rose-500">*</span>
              </label>
              <input
                type="email"
                id="reg-email"
                required
                placeholder="nama@email.com"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-[#d6e3d9] bg-[#fbfdfb] text-gray-800 placeholder-gray-400 focus:outline-hidden focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] transition-all"
              />
            </div>
          </div>

          {isRunningEvent && (
            <div>
              <label for="reg-jersey" class="block text-xs font-bold text-[#1b3825] mb-1">
                Ukuran Jersey Lari (Opsional)
              </label>
              <select
                id="reg-jersey"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-[#d6e3d9] bg-[#fbfdfb] text-gray-800 focus:outline-hidden focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] transition-all"
              >
                <option value="M">Size M (Medium)</option>
                <option value="S">Size S (Small)</option>
                <option value="L">Size L (Large)</option>
                <option value="XL">Size XL (Extra Large)</option>
                <option value="XXL">Size XXL</option>
              </select>
            </div>
          )}

          <div>
            <label for="reg-note" class="block text-xs font-bold text-[#1b3825] mb-1">
              Catatan / Permintaan Khusus (Opsional)
            </label>
            <textarea
              id="reg-note"
              rows="2"
              placeholder="Contoh: Request tempat duduk berdekatan, info komunitas lari..."
              class="w-full px-3.5 py-2 text-xs rounded-xl border border-[#d6e3d9] bg-[#fbfdfb] text-gray-800 placeholder-gray-400 focus:outline-hidden focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] transition-all"
            ></textarea>
          </div>
        </div>

        <!-- 4. Price Calculation Box -->
        <div class="p-4 bg-[#edf4ee] rounded-2xl border border-[#d3e5d7] flex items-center justify-between">
          <div>
            <span class="text-[11px] text-[#44634d] block font-medium">Total Pembayaran / Estimasi</span>
            <span id="tier-calc-label" class="text-[11px] text-[#63806b]">Rp 125.000 x 1 tiket</span>
          </div>
          <div class="text-right">
            <span id="total-price-display" class="text-lg font-extrabold text-[#1b3825]">
              Rp 125.000
            </span>
          </div>
        </div>

        <!-- 5. Submit Button -->
        <button
          type="submit"
          id="btn-submit-reg"
          class="w-full py-3.5 px-6 rounded-2xl bg-[#2d553b] hover:bg-[#1a3825] text-white font-bold text-xs sm:text-sm shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current text-white" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z" />
          </svg>
          <span>Konfirmasi & Daftar Sekarang</span>
        </button>

        <p class="text-[10px] text-center text-gray-400">
          Dengan menekan tombol, Anda menyetujui syarat & ketentuan penyelenggara Halo Malang.
        </p>

      </form>
    </div>

    <!-- Success View (Hidden by default) -->
    <div id="modal-success-wrapper" class="hidden p-8 text-center">
      <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <h4 class="text-xl font-bold font-sans text-[#1b3825] mb-2">Pendaftaran Berhasil Dicatat!</h4>
      <p class="text-xs text-[#526a58] leading-relaxed mb-6 max-w-sm mx-auto">
        Terima kasih, data pendaftaran Anda telah tersimpan. Silakan lanjutkan verifikasi via WhatsApp untuk menerima e-ticket resmi.
      </p>

      <div class="bg-[#f2f7f3] p-4 rounded-2xl border border-[#dbe8de] text-left text-xs mb-6 max-w-sm mx-auto space-y-2">
        <div class="flex justify-between">
          <span class="text-gray-500">Kode Booking:</span>
          <span id="succ-booking-code" class="font-mono font-bold text-[#2d553b]">HM-EVT-XXXX</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Event:</span>
          <span class="font-bold text-[#1b3825] text-right line-clamp-1">{event.title}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Kategori Tiket:</span>
          <span id="succ-tier" class="font-semibold text-gray-800">Regular</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Jumlah:</span>
          <span id="succ-qty" class="font-semibold text-gray-800">1 Tiket</span>
        </div>
        <div class="flex justify-between pt-2 border-t border-[#dbe8de]">
          <span class="font-bold text-gray-700">Total:</span>
          <span id="succ-total" class="font-bold text-[#2d553b]">Rp 0</span>
        </div>
      </div>

      <div class="space-y-2.5 max-w-sm mx-auto">
        <a
          id="succ-wa-link"
          href="#"
          target="_blank"
          class="w-full py-3 px-5 rounded-2xl bg-[#2d553b] hover:bg-[#1a3825] text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition-all"
        >
          <svg class="w-4 h-4 fill-current text-white" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z" />
          </svg>
          <span>Konfirmasi ke WhatsApp Admin</span>
        </a>

        <button
          type="button"
          id="btn-succ-close"
          class="w-full py-2.5 px-4 rounded-2xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-xs transition-colors cursor-pointer"
        >
          Tutup
        </button>
      </div>

    </div>

  </div>
</div>

<script is:inline define:vars={{ whatsappNumber: businessInfo.whatsapp, eventTitle: event.title, eventDate: event.date, isRunningEvent }}>
  (function() {
    var modal = document.getElementById('event-reg-modal');
    var closeBtn = document.getElementById('close-reg-modal');
    var form = document.getElementById('event-reg-form');
    var formWrapper = document.getElementById('modal-form-wrapper');
    var succWrapper = document.getElementById('modal-success-wrapper');
    var succCloseBtn = document.getElementById('btn-succ-close');

    var qtyValEl = document.getElementById('qty-val');
    var qtyMinusBtn = document.getElementById('qty-minus');
    var qtyPlusBtn = document.getElementById('qty-plus');

    var calcLabelEl = document.getElementById('tier-calc-label');
    var totalPriceEl = document.getElementById('total-price-display');

    var currentQty = 1;

    // Helper: format rupiah
    function formatRupiah(number) {
      if (number === 0) return 'Gratis (Rp 0)';
      return 'Rp ' + number.toLocaleString('id-ID');
    }

    // Update price calculation
    function updateCalc() {
      var selectedTier = document.querySelector('input[name="ticket_tier"]:checked');
      var price = selectedTier ? parseInt(selectedTier.getAttribute('data-price') || '0', 10) : 0;
      var tierName = selectedTier ? selectedTier.getAttribute('data-name') : '';

      var total = price * currentQty;
      if (calcLabelEl) {
        calcLabelEl.textContent = (price === 0 ? 'Gratis' : formatRupiah(price)) + ' x ' + currentQty + ' tiket (' + tierName + ')';
      }
      if (totalPriceEl) {
        totalPriceEl.textContent = formatRupiah(total);
      }
    }

    // Modal open handlers
    function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      updateCalc();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      if (formWrapper && succWrapper) {
        formWrapper.classList.remove('hidden');
        succWrapper.classList.add('hidden');
      }
    }

    // Event triggers for opening modal
    document.querySelectorAll('[data-open-reg-modal]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        openModal();
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (succCloseBtn) succCloseBtn.addEventListener('click', closeModal);

    // Close when clicking backdrop
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });
    }

    // ESC key closes modal
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Quantity buttons
    if (qtyMinusBtn) {
      qtyMinusBtn.addEventListener('click', function() {
        if (currentQty > 1) {
          currentQty--;
          if (qtyValEl) qtyValEl.textContent = currentQty;
          updateCalc();
        }
      });
    }

    if (qtyPlusBtn) {
      qtyPlusBtn.addEventListener('click', function() {
        if (currentQty < 10) {
          currentQty++;
          if (qtyValEl) qtyValEl.textContent = currentQty;
          updateCalc();
        }
      });
    }

    // Tier change
    document.querySelectorAll('input[name="ticket_tier"]').forEach(function(radio) {
      radio.addEventListener('change', updateCalc);
    });

    // Submit handler
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();

        var name = (document.getElementById('reg-name') || {}).value || '';
        var phone = (document.getElementById('reg-phone') || {}).value || '';
        var email = (document.getElementById('reg-email') || {}).value || '';
        var note = (document.getElementById('reg-note') || {}).value || '-';
        var jerseyEl = document.getElementById('reg-jersey');
        var jersey = jerseyEl ? jerseyEl.value : '';

        var selectedTier = document.querySelector('input[name="ticket_tier"]:checked');
        var tierName = selectedTier ? selectedTier.getAttribute('data-name') : 'Reguler';
        var price = selectedTier ? parseInt(selectedTier.getAttribute('data-price') || '0', 10) : 0;
        var totalFormatted = formatRupiah(price * currentQty);

        var randomCode = 'HM-EVT-' + Math.floor(1000 + Math.random() * 9000);

        // Update Success UI
        var bCode = document.getElementById('succ-booking-code');
        var sTier = document.getElementById('succ-tier');
        var sQty = document.getElementById('succ-qty');
        var sTotal = document.getElementById('succ-total');
        var waLink = document.getElementById('succ-wa-link');

        if (bCode) bCode.textContent = randomCode;
        if (sTier) sTier.textContent = tierName;
        if (sQty) sQty.textContent = currentQty + ' Tiket';
        if (sTotal) sTotal.textContent = totalFormatted;

        // Compose WhatsApp message
        var msg = 'Halo Admin Halo Malang, saya ingin mendaftar event:\n\n' +
          '*Kode Booking:* ' + randomCode + '\n' +
          '*Event:* ' + eventTitle + ' (' + eventDate + ')\n' +
          '*Nama Pemesan:* ' + name + '\n' +
          '*WhatsApp:* ' + phone + '\n' +
          '*Email:* ' + email + '\n' +
          '*Kategori Tiket:* ' + tierName + '\n' +
          '*Jumlah:* ' + currentQty + ' Tiket\n' +
          '*Total Biaya:* ' + totalFormatted + '\n' +
          (isRunningEvent ? '*Ukuran Jersey:* ' + jersey + '\n' : '') +
          '*Catatan:* ' + note + '\n\n' +
          'Mohon informasi langkah verifikasi dan pengiriman e-ticket. Terima kasih!';

        var waUrl = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent(msg);
        if (waLink) waLink.setAttribute('href', waUrl);

        // Switch to success view
        if (formWrapper && succWrapper) {
          formWrapper.classList.add('hidden');
          succWrapper.classList.remove('hidden');
        }

        // Open WhatsApp in new tab
        window.open(waUrl, '_blank');
      });
    }

  })();
</script>
