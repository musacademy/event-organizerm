---
import { businessInfo } from '../data/business';
---

<footer class="bg-[#1b3825] text-[#d6e5d9] pt-16 pb-12 mt-20 border-t border-[#2a4d36]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-[#2a4d36]/60">
      
      <!-- Brand & Mission -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-2xl bg-[#3f724f] flex items-center justify-center text-white">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <div>
            <span class="font-sans text-2xl font-extrabold tracking-tight text-white block leading-none">Halo Malang</span>
            <span class="text-[11px] font-semibold text-[#8eb697] tracking-wider uppercase mt-1 block">Studio Penyelenggara Acara</span>
          </div>
        </div>

        <p class="text-sm text-[#b2ceb9] leading-relaxed mb-6 max-w-sm">
          {businessInfo.legalName} adalah Event Organizer profesional berdedikasi tinggi yang melayani penyelenggaraan Corporate Gathering, Wedding, Seminar, Festival Musik, dan Custom Event di Malang, Kediri, dan sekitarnya.
        </p>

        <div class="flex items-center gap-3">
          <a href={businessInfo.socials.instagram} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-[#274d34] flex items-center justify-center text-white hover:bg-[#3f724f] transition-colors" aria-label="Instagram">
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href={businessInfo.socials.tiktok} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-[#274d34] flex items-center justify-center text-white hover:bg-[#3f724f] transition-colors" aria-label="TikTok">
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
            </svg>
          </a>
          <a href={businessInfo.socials.youtube} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-[#274d34] flex items-center justify-center text-white hover:bg-[#3f724f] transition-colors" aria-label="YouTube">
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Nav Links -->
      <div>
        <h3 class="text-white font-semibold text-sm mb-4 tracking-wider uppercase">Menu Utama</h3>
        <ul class="space-y-2.5 text-sm text-[#c8e2cd]">
          <li><a href="/" class="hover:text-white transition-colors">Beranda</a></li>
          <li><a href="/tentang-kami" class="hover:text-white transition-colors">Tentang Kami</a></li>
          <li><a href="/event" class="hover:text-white transition-colors">Event Mendatang</a></li>
          <li><a href="/portofolio" class="hover:text-white transition-colors">Portofolio Acara</a></li>
          <li><a href="/galeri" class="hover:text-white transition-colors">Galeri Dokumentasi</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Blog & Panduan Acara</a></li>
          <li><a href="/kontak" class="hover:text-white transition-colors">Formulir & Kontak</a></li>
        </ul>
      </div>

      <!-- Local SEO Landing Pages -->
      <div>
        <h3 class="text-white font-semibold text-sm mb-4 tracking-wider uppercase">Layanan Wilayah</h3>
        <ul class="space-y-2.5 text-sm text-[#c8e2cd]">
          <li>
            <a href="/layanan" class="hover:text-white transition-colors flex items-center gap-1.5 font-medium text-emerald-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Event Organizer Malang & Kediri
            </a>
          </li>
          <li><span class="text-xs text-[#b4d6be] block pt-2">Cakupan Wilayah Terpadu:</span></li>
          <li class="text-xs text-[#b4d6be]">Kota Malang & Kabupaten Malang</li>
          <li class="text-xs text-[#b4d6be]">Kota Wisata Batu (Outbound & Retreat)</li>
          <li class="text-xs text-[#b4d6be]">Kota Kediri & Kabupaten Kediri</li>
        </ul>
      </div>

      <!-- Office & Contacts -->
      <div class="lg:col-span-1">
        <h3 class="text-white font-semibold text-sm mb-4 tracking-wider uppercase">Kontak & Kantor</h3>
        <div class="space-y-3 text-xs text-[#c8e2cd]">
          <div>
            <span class="text-white font-medium block">Kantor Utama Malang:</span>
            <span>Jl. Besar Ijen No. 42, Klojen, Kota Malang 65115</span>
          </div>
          <div>
            <span class="text-white font-medium block">Hub Operasional Kediri:</span>
            <span>Jl. Dhoho No. 88, Pakelan, Kota Kediri 64129</span>
          </div>
          <div class="pt-2 border-t border-[#2a4d36]">
            <a href={`https://wa.me/${businessInfo.whatsapp}`} class="text-emerald-300 hover:text-white block font-medium">
              WhatsApp: {businessInfo.phone}
            </a>
            <span class="block text-[#b4d6be] mt-1 font-medium">Jam: 08.00 - 18.00 WIB (Darurat 24/7)</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom copyright and note -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-[#b8d7c0] gap-4 text-center md:text-left">
      <p>&copy; {new Date().getFullYear()} {businessInfo.name} ({businessInfo.legalName}). Hak Cipta Dilindungi.</p>
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
        <a href="/tentang-kami" class="text-[#c2dfca] hover:text-white transition-colors underline-offset-2 hover:underline">Kebijakan Layanan</a>
        <a href="/kontak" class="text-[#c2dfca] hover:text-white transition-colors underline-offset-2 hover:underline">Konsultasi Biaya</a>
        <a href="/sitemap-index.xml" class="text-[#c2dfca] hover:text-white transition-colors underline-offset-2 hover:underline">Sitemap XML</a>
      </div>
    </div>
  </div>
</footer>
