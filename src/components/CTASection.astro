---
import { businessInfo } from '../data/business';

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  primaryCtaText?: string;
  primaryCtaUrl?: string;
  secondaryCtaText?: string;
  secondaryCtaUrl?: string;
}

const {
  badge = 'Konsultasi Gratis & Tanpa Komitmen',
  title = 'Siap Mewujudkan Acara Luar Biasa Anda di Malang & Kediri?',
  subtitle = 'Diskusikan rencana Corporate Gathering, Wedding, Seminar, atau Festival Anda bersama tim profesional Halo Malang. Dapatkan konsep visual awal dan rincian estimasi anggaran transparan dalam 1x24 jam.',
  primaryCtaText = 'Konsultasi via WhatsApp',
  primaryCtaUrl = `https://wa.me/${businessInfo.whatsapp}?text=Halo%20Halo%20Malang,%20saya%20ingin%20berkonsultasi%20mengenai%20rencana%20acara%20di%20Malang/Kediri.`,
  secondaryCtaText = 'Ajukan Formulir Acara',
  secondaryCtaUrl = '/kontak',
} = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-14 sm:mt-20 mb-8 reveal-on-scroll">
  <div class="relative rounded-[2.5rem] sm:rounded-[3rem] overflow-hidden bg-gradient-to-br from-[#112418] via-[#1b3825] to-[#255235] text-white p-8 sm:p-14 lg:p-16 shadow-2xl border border-emerald-500/20">
    
    <!-- Background Ambient Glow & Lighting Effects -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-400/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#3f724f]/25 rounded-full blur-3xl pointer-events-none"></div>
    
    <!-- Subtle Background Texture Overlay -->
    <div 
      class="absolute inset-0 opacity-10 mix-blend-overlay pointer-events-none bg-cover bg-center" 
      style="background-image: url('/images/hero-stage.webp');"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-3xl">
      
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs font-semibold text-emerald-200 mb-6 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>{badge}</span>
      </div>

      <!-- Main Headline -->
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold font-sans tracking-tight text-white leading-[1.18] mb-5">
        {title}
      </h2>

      <!-- Description / Value Proposition -->
      <p class="text-sm sm:text-base text-emerald-100/90 leading-relaxed mb-8 max-w-2xl font-normal">
        {subtitle}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3.5 mb-10">
        <!-- WhatsApp Primary Button -->
        <a
          href={primaryCtaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-7 py-4 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white text-sm font-bold transition-all duration-300 shadow-lg hover:shadow-2xl hover:scale-103 group"
        >
          <svg class="w-5 h-5 fill-current transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zM12.05 20.2c-1.5 0-2.97-.4-4.26-1.16l-.31-.18-3.16.83.84-3.08-.2-.32a8.21 8.21 0 01-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 012.41 5.83c.02 4.54-3.68 8.24-8.38 8.24zm4.51-6.17c-.25-.12-1.47-.72-1.7-.8-.23-.09-.39-.13-.56.12-.17.25-.64.8-.79.97-.14.17-.29.19-.54.07-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.23.9 2.43 1.02 2.6.13.16 1.77 2.7 4.29 3.79.6.26 1.07.41 1.44.53.6.19 1.15.16 1.59.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.28z"/>
          </svg>
          <span>{primaryCtaText}</span>
        </a>

        <!-- Secondary Form Button -->
        <a
          href={secondaryCtaUrl}
          class="inline-flex items-center gap-2 px-7 py-4 rounded-full bg-white/10 hover:bg-white text-white hover:text-[#1b3825] text-sm font-semibold transition-all duration-300 backdrop-blur-md border border-white/20 hover:scale-103 shadow-md"
        >
          <span>{secondaryCtaText}</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Trust Pillars / Value Guarantees -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-white/15">
        <div class="flex items-center gap-2.5 text-xs text-emerald-100/90">
          <div class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-300 shrink-0">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <span>Respons Cepat 1x24 Jam</span>
        </div>

        <div class="flex items-center gap-2.5 text-xs text-emerald-100/90">
          <div class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-300 shrink-0">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <span>Biaya Transparan & Terinci</span>
        </div>

        <div class="flex items-center gap-2.5 text-xs text-emerald-100/90">
          <div class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-300 shrink-0">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <span>2 Hub di Malang & Kediri</span>
        </div>
      </div>

    </div>

  </div>
</section>
