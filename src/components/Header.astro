---
import { businessInfo } from '../data/business';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: 'Beranda', href: '/' },
  { name: 'Tentang Kami', href: '/tentang-kami' },
  { name: 'Portofolio', href: '/portofolio' },
  { name: 'Galeri', href: '/galeri' },
  { name: 'Blog', href: '/blog' },
  { name: 'Kontak', href: '/kontak' },
];

const isCurrent = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="sticky top-0 z-50 bg-[#f7f9f7]/90 backdrop-blur-md border-b border-[#e5ece6] transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-2xl bg-[#2d553b] flex items-center justify-center text-white shadow-sm transition-transform group-hover:scale-105">
          <svg class="w-5 h-5 text-[#cde6d2]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
        </div>
        <div>
          <span class="font-sans text-2xl font-extrabold tracking-tight text-[#1b3825] block leading-none">Aethel</span>
          <span class="text-[11px] font-semibold text-[#4e785b] tracking-wider uppercase mt-1 block">Event Malang & Kediri</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 bg-white/80 px-4 py-2 rounded-full border border-[#e1eae2] shadow-xs">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`px-4 py-1.5 text-sm font-medium rounded-full transition-all duration-150 ${
              isCurrent(item.href)
                ? 'bg-[#2d553b] text-white shadow-xs'
                : 'text-[#415446] hover:text-[#1b3825] hover:bg-[#eaf1ec]'
            }`}
          >
            {item.name}
          </a>
        ))}
      </nav>

      <!-- Right Action Items (Search, Notification, and WhatsApp CTA matching reference) -->
      <div class="hidden lg:flex items-center gap-3">
        <!-- Search trigger button -->
        <a 
          href="/portofolio" 
          title="Cari Portofolio & Acara"
          class="w-10 h-10 rounded-full bg-white border border-[#e1eae2] flex items-center justify-center text-[#415446] hover:text-[#2d553b] hover:border-[#2d553b] transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>

        <!-- Location quick selector pill -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 text-xs font-semibold px-3 py-2 rounded-full bg-[#eaf2eb] text-[#2d553b] hover:bg-[#d8e7da] transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
            <span>Kota Layanan</span>
            <svg class="w-3 h-3 text-[#2d553b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="absolute right-0 mt-2 w-48 bg-white rounded-2xl shadow-lg border border-[#e1eae2] py-2 hidden group-hover:block group-focus-within:block transition-all">
            <a href="/event-organizer-malang" class="block px-4 py-2 text-xs font-medium text-[#2d553b] hover:bg-[#f2f7f3] flex items-center justify-between">
              <span>Event Organizer Malang</span>
              <span class="text-[10px] bg-[#e3ece4] px-1.5 py-0.5 rounded text-[#2d553b]">Pusat</span>
            </a>
            <a href="/event-organizer-kediri" class="block px-4 py-2 text-xs font-medium text-[#2d553b] hover:bg-[#f2f7f3] flex items-center justify-between">
              <span>Event Organizer Kediri</span>
              <span class="text-[10px] bg-[#e3ece4] px-1.5 py-0.5 rounded text-[#2d553b]">Hub</span>
            </a>
          </div>
        </div>

        <!-- Consultation Button with Avatar matching reference design -->
        <a
          href={`https://wa.me/${businessInfo.whatsapp}?text=Halo%20Aethel%20Events,%20saya%20ingin%20konsultasi%20mengenai%20penyelenggaraan%20acara.`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 pl-2 pr-4 py-1.5 bg-[#2d553b] hover:bg-[#1b3825] text-white rounded-full text-xs font-medium transition-all shadow-xs group"
        >
          <img 
            src="/images/client-portrait.jpg" 
            alt="Event Consultant" 
            class="w-7 h-7 rounded-full object-cover border border-white/50"
          />
          <span>Konsultasi WA</span>
          <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center gap-2 md:hidden">
        <a
          href={`https://wa.me/${businessInfo.whatsapp}`}
          target="_blank"
          class="p-2 text-[#2d553b] bg-white rounded-full border border-[#e1eae2]"
          aria-label="WhatsApp"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z" />
          </svg>
        </a>

        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-full text-[#2d553b] bg-white border border-[#e1eae2] focus:outline-none"
          aria-label="Toggle Navigation"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-[#e5ece6] px-4 pt-3 pb-6 shadow-xl animate-fade-in">
    <div class="flex flex-col space-y-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-4 py-2.5 rounded-xl text-sm font-medium ${
            isCurrent(item.href)
              ? 'bg-[#2d553b] text-white'
              : 'text-[#415446] hover:bg-[#f2f7f3]'
          }`}
        >
          {item.name}
        </a>
      ))}
      <div class="pt-3 border-t border-gray-100 flex flex-col gap-2">
        <a href="/event-organizer-malang" class="text-xs font-semibold px-4 py-2 bg-[#f0f6f1] text-[#2d553b] rounded-xl flex items-center justify-between">
          <span>Halaman Malang</span>
          <span class="text-[10px] bg-white px-2 py-0.5 rounded text-[#2d553b]">SEO Landing</span>
        </a>
        <a href="/event-organizer-kediri" class="text-xs font-semibold px-4 py-2 bg-[#f0f6f1] text-[#2d553b] rounded-xl flex items-center justify-between">
          <span>Halaman Kediri</span>
          <span class="text-[10px] bg-white px-2 py-0.5 rounded text-[#2d553b]">SEO Landing</span>
        </a>
        <a
          href={`https://wa.me/${businessInfo.whatsapp}`}
          target="_blank"
          class="mt-2 text-center py-3 bg-[#2d553b] text-white rounded-xl text-sm font-semibold shadow-xs"
        >
          Chat WhatsApp Konsultan Event
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
