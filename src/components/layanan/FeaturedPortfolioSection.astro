---
import { portfolioData } from '../../data/portfolio';

const featuredProjects = portfolioData.slice(0, 6);
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
    <div>
      <h3 class="text-2xl sm:text-3xl font-sans font-extrabold text-[#1b3825]">
        Portofolio Proyek Pilihan di Malang & Kediri
      </h3>
      <p class="text-xs sm:text-sm text-[#546b5a] mt-1">
        Bukti nyata keandalan eksekusi acara di berbagai lokasi bergengsi Jawa Timur.
      </p>
    </div>
    <a href="/portofolio" class="text-xs font-bold text-[#2d553b] hover:underline flex items-center gap-1">
      <span>Lihat Semua Portofolio ({portfolioData.length})</span>
      <span>&rarr;</span>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {featuredProjects.map((item) => (
      <a
        href={`/portofolio/${item.slug}`}
        class="bg-white rounded-3xl overflow-hidden border border-[#e2ece4] shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group cursor-pointer block"
      >
        <div>
          <div class="relative w-full h-48 overflow-hidden bg-gray-100">
            <img
              src={item.featuredImage}
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-3 left-3 px-3 py-1 bg-[#2d553b] text-white text-[10px] font-bold rounded-full">
              {item.category}
            </span>
            <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-xs px-2.5 py-1 rounded-full text-[10px] font-medium text-[#2d553b]">
              {item.location}
            </div>
          </div>

          <div class="p-6">
            <div class="text-[11px] text-[#63806b] mb-1 font-medium">{item.date} &bull; {item.attendees}</div>
            <h4 class="text-sm font-bold text-[#1b3825] group-hover:text-[#2d553b] transition-colors leading-snug line-clamp-1 mb-2">
              {item.title}
            </h4>
            <p class="text-xs text-[#526a58] leading-relaxed line-clamp-2">
              {item.description}
            </p>
          </div>
        </div>

        <div class="p-6 pt-0 border-t border-[#edf4ee] flex items-center justify-between">
          <span class="text-[11px] text-[#698570]">Klien: {item.client}</span>
          <span class="text-xs font-bold text-[#2d553b] group-hover:underline inline-flex items-center gap-1">
            <span>Detail</span>
            <span class="group-hover:translate-x-1 transition-transform duration-200">&rarr;</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
