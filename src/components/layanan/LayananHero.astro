---
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-8">
  <div class="relative bg-white rounded-[2rem] sm:rounded-[2.75rem] border border-[#e2ece4] overflow-hidden shadow-xs p-3 sm:p-5">
    <div class="relative w-full h-[480px] sm:h-[540px] rounded-[1.75rem] sm:rounded-[2.25rem] overflow-hidden">
      <img
        src="/images/corporate-malang.webp"
        alt="Layanan Event Organizer Terpadu Malang dan Kediri"
        class="w-full h-full object-cover object-center"
        width="1000"
        height="747"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#13271a]/95 via-[#1a3825]/65 to-black/35"></div>

      <div class="absolute inset-0 p-6 sm:p-12 lg:p-16 flex flex-col justify-end max-w-3xl text-white">
        <!-- Hub Status Pill -->
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold text-emerald-100 border border-white/20">
            <span class="w-2 h-2 rounded-full bg-emerald-300"></span>
            Malang (Head Office)
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold text-emerald-100 border border-white/20">
            <span class="w-2 h-2 rounded-full bg-emerald-300"></span>
            Kediri (Operational Hub)
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold font-sans tracking-tight leading-tight mb-4 text-white">
          Solusi Event Organizer Terpadu untuk Malang & Kediri.
        </h1>

        <p class="text-xs sm:text-sm text-[#d8ebd9] font-normal leading-relaxed mb-6 max-w-xl">
          Satu tim terintegrasi untuk seluruh kebutuhan acara Anda. Dari sejuknya venue Kota Malang & Batu hingga pesatnya aktivitas korporat dan festival di Kediri, kami hadirkan eksekusi panggung, logistik, dan show management tanpa kompromi.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="#konsultasi"
            class="px-6 py-3 rounded-full bg-[#2d553b] hover:bg-[#1a3825] text-white text-xs sm:text-sm font-semibold transition-all shadow-md border border-emerald-400/30"
          >
            Konsultasi Acara Sekarang
          </a>
          <a
            href="#kategori-layanan"
            class="px-5 py-3 rounded-full bg-white/90 hover:bg-white text-[#1b3825] text-xs font-semibold transition-all"
          >
            Lihat Kategori Layanan &darr;
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
