---
import { businessInfo } from '../../data/business';

interface NavItem {
  name: string;
  href: string;
}

interface Props {
  navItems: NavItem[];
  currentPath?: string;
}

const { navItems, currentPath = '/' } = Astro.props;

const isCurrent = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<!-- Mobile Drawer Backdrop -->
<div
  id="mobile-drawer-backdrop"
  class="fixed inset-0 bg-black/50 backdrop-blur-xs z-[90] opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
  aria-hidden="true"
></div>

<!-- Mobile Slide-over Drawer -->
<aside
  id="mobile-drawer"
  class="fixed top-0 right-0 w-[85%] max-w-sm h-screen h-[100dvh] bg-white z-[100] shadow-2xl translate-x-full transition-transform duration-300 ease-out md:hidden flex flex-col justify-between overflow-hidden"
  aria-label="Menu Mobile"
>
  <!-- Drawer Header with Logo & Close Button -->
  <div class="p-6 border-b border-gray-100 flex items-center justify-between">
    <a href="/" class="flex items-center">
      <span class="font-script text-2xl font-bold tracking-tight text-gray-950 block leading-none">
        Halo Malang
      </span>
    </a>

    <button
      id="mobile-drawer-close"
      type="button"
      class="w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 hover:text-gray-900 flex items-center justify-center transition-colors focus:outline-none cursor-pointer"
      aria-label="Tutup Menu"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Navigation Links -->
  <div class="flex-1 overflow-y-auto px-6 py-6 space-y-1.5 custom-scrollbar">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`flex items-center justify-between px-4 py-3 rounded-2xl text-sm font-semibold transition-all ${
          isCurrent(item.href)
            ? 'bg-[#2d553b] text-white shadow-sm'
            : 'text-gray-700 hover:bg-[#eaf4ec] hover:text-[#2d553b]'
        }`}
      >
        <span>{item.name}</span>
        {isCurrent(item.href) ? (
          <span class="w-2 h-2 rounded-full bg-emerald-300"></span>
        ) : (
          <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
      </a>
    ))}

    <!-- Regional Hubs -->
    <div class="pt-6 mt-4 border-t border-gray-100 space-y-2">
      <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400 block px-2 mb-1">
        Wilayah Operasional
      </span>
      <a
        href="/layanan"
        class="flex items-center justify-between px-4 py-3 rounded-2xl bg-[#f4f8f5] text-xs font-semibold text-[#2d553b] hover:bg-[#eaf4ec] transition-colors"
      >
        <div class="flex flex-col">
          <span class="font-bold text-[#1b3825]">Malang & Kediri</span>
          <span class="text-[10px] text-[#55715d]">Hub Operasional Terintegrasi</span>
        </div>
        <span class="text-[10px] bg-[#2d553b] text-white px-2.5 py-1 rounded-full font-medium">Layanan &rarr;</span>
      </a>
    </div>
  </div>

  <!-- Drawer Footer CTA -->
  <div class="p-6 border-t border-gray-100 bg-[#fbfdfb]">
    <a
      href={`https://wa.me/${businessInfo.whatsapp}?text=Halo%20Halo%20Malang,%20saya%20ingin%20konsultasi%20acara.`}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full py-3.5 px-4 bg-[#2d553b] hover:bg-[#1f3f2a] text-white rounded-full text-sm font-semibold transition-all shadow-md flex items-center justify-center gap-2"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
      <span>WhatsApp Konsultasi</span>
    </a>
  </div>
</aside>

<script>
  function initMobileDrawer() {
    const btn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-drawer-close');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const drawer = document.getElementById('mobile-drawer');

    function openDrawer() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
      btn?.setAttribute('aria-expanded', 'true');
    }

    function closeDrawer() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove('translate-x-0');
      drawer.classList.add('translate-x-full');
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      btn?.setAttribute('aria-expanded', 'false');
    }

    btn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });

    drawer?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });
  }

  initMobileDrawer();
  document.addEventListener('astro:page-load', initMobileDrawer);
</script>
