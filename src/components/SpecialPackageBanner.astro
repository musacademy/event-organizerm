---
import { businessInfo } from '../data/business';
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 reveal-on-scroll">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Left Banner matching "Super Sale" card with countdown -->
    <div class="lg:col-span-2 bg-white rounded-3xl p-6 sm:p-8 border border-[#e2ece4] shadow-xs flex flex-col justify-between relative overflow-hidden">
      
      <!-- Top info and Price -->
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-6">
        <div>
          <span class="inline-block text-[11px] font-bold tracking-widest text-[#2d553b] bg-[#eaf2eb] px-3 py-1 rounded-full mb-2">
            Penawaran Spesial Semester Ini
          </span>
          <h3 class="text-xl sm:text-2xl font-extrabold font-sans text-[#1b3825]">
            Paket All-in-One Corporate Gathering & Outbound
          </h3>
          <p class="text-xs sm:text-sm text-[#526a58] mt-1 max-w-md">
            Khusus area Batu Malang & Kediri. Sudah termasuk venue coordination, games fasilitator tersertifikasi, live music acoustic, dan panggung lighting.
          </p>
        </div>

        <div class="sm:text-right shrink-0">
          <span class="text-[10px] text-[#718876] uppercase tracking-wider block">Harga Spesial Paket</span>
          <div class="text-2xl sm:text-3xl font-black text-[#2d553b]">Rp 24,5 Jt</div>
          <span class="text-[10px] line-through text-gray-400">Normal Rp 32.000.000</span>
        </div>
      </div>

      <!-- Live Countdown Timer matching "07 : 13 : 23 : 03" in reference image -->
      <div class="mb-6">
        <span class="text-[10px] font-bold uppercase text-[#526a58] tracking-wider block mb-2">
          Batas Waktu Booking Kuota Promo:
        </span>
        <div class="flex items-center gap-2 sm:gap-3 text-center">
          <div class="bg-[#f0f6f1] rounded-2xl px-3 py-2 min-w-[54px] border border-[#d9e7dc]">
            <span id="timer-days" class="text-lg font-extrabold text-[#1b3825] block leading-tight">07</span>
            <span class="text-[9px] uppercase text-[#617967] font-semibold">Hari</span>
          </div>
          <span class="text-lg font-bold text-[#8ba391]">:</span>
          <div class="bg-[#f0f6f1] rounded-2xl px-3 py-2 min-w-[54px] border border-[#d9e7dc]">
            <span id="timer-hours" class="text-lg font-extrabold text-[#1b3825] block leading-tight">13</span>
            <span class="text-[9px] uppercase text-[#617967] font-semibold">Jam</span>
          </div>
          <span class="text-lg font-bold text-[#8ba391]">:</span>
          <div class="bg-[#f0f6f1] rounded-2xl px-3 py-2 min-w-[54px] border border-[#d9e7dc]">
            <span id="timer-minutes" class="text-lg font-extrabold text-[#1b3825] block leading-tight">23</span>
            <span class="text-[9px] uppercase text-[#617967] font-semibold">Menit</span>
          </div>
          <span class="text-lg font-bold text-[#8ba391]">:</span>
          <div class="bg-[#f0f6f1] rounded-2xl px-3 py-2 min-w-[54px] border border-[#d9e7dc]">
            <span id="timer-seconds" class="text-lg font-extrabold text-[#2d553b] block leading-tight">03</span>
            <span class="text-[9px] uppercase text-[#617967] font-semibold">Detik</span>
          </div>
        </div>
      </div>

      <!-- Image and CTA matching reference layout -->
      <div class="relative w-full h-44 sm:h-52 rounded-2xl overflow-hidden group">
        <img
          src="/images/gathering-batu.webp"
          alt="Outdoor corporate gathering di Batu Malang"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
          decoding="async"
          width="500"
          height="208"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
        <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
          <span class="px-3 py-1 bg-emerald-600 text-white text-[11px] font-bold rounded-full shadow-xs">
            Slot Tersisa: 3 Event
          </span>
          <a
            href={`https://wa.me/${businessInfo.whatsapp}?text=Halo%20Aethel%20Events,%20saya%20tertarik%20dengan%20Paket%20All-in-One%20Corporate%20Gathering%20Malang-Kediri.`}
            target="_blank"
            class="px-4 py-2 bg-white text-[#1b3825] hover:bg-[#eaf2eb] rounded-full text-xs font-bold transition-all shadow-md"
          >
            Klaim Paket Promo
          </a>
        </div>
      </div>

    </div>

    <!-- Right Side: Dual Arched Showcase Windows matching reference right side of Super Sale -->
    <div class="grid grid-cols-2 gap-3 h-full">
      <div class="relative rounded-3xl overflow-hidden border border-[#e2ece4] h-full min-h-[280px] group shadow-xs">
        <img
          src="/images/wedding-reception.webp"
          alt="Intimate wedding reception setup"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
          decoding="async"
          width="500"
          height="400"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#1b3825]/90 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 left-3 right-3 text-white">
          <span class="text-[10px] uppercase font-bold text-emerald-300">Wedding Vibe</span>
          <h3 class="text-xs font-bold leading-snug">Botanical Intimate Batu & Kediri</h3>
        </div>
      </div>

      <div class="relative rounded-3xl overflow-hidden border border-[#e2ece4] h-full min-h-[280px] group shadow-xs">
        <img
          src="/images/corporate-malang.webp"
          alt="Corporate innovation stage Malang"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
          decoding="async"
          width="500"
          height="400"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#1b3825]/90 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 left-3 right-3 text-white">
          <span class="text-[10px] uppercase font-bold text-emerald-300">Corporate Vibe</span>
          <h3 class="text-xs font-bold leading-snug">Grand Ballroom Gala & Seminar</h3>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  // Countdown simulation
  let totalSeconds = 7 * 86400 + 13 * 3600 + 23 * 60 + 3;
  const daysEl = document.getElementById('timer-days');
  const hoursEl = document.getElementById('timer-hours');
  const minsEl = document.getElementById('timer-minutes');
  const secsEl = document.getElementById('timer-seconds');

  setInterval(() => {
    if (totalSeconds > 0) {
      totalSeconds--;
      const d = Math.floor(totalSeconds / 86400);
      const h = Math.floor((totalSeconds % 86400) / 3600);
      const m = Math.floor((totalSeconds % 3600) / 60);
      const s = totalSeconds % 60;

      if (daysEl) daysEl.innerText = String(d).padStart(2, '0');
      if (hoursEl) hoursEl.innerText = String(h).padStart(2, '0');
      if (minsEl) minsEl.innerText = String(m).padStart(2, '0');
      if (secsEl) secsEl.innerText = String(s).padStart(2, '0');
    }
  }, 1000);
</script>
