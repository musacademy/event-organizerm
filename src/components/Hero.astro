---
import { businessInfo } from '../data/business';
---

<section class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 pt-1 sm:pt-2 pb-8">
  <!-- Outer Hero Card Wrapper with entrance animation -->
  <div class="relative w-full animate-hero-reveal">

    <!-- Hero Card Container with Clean Rounded Frame -->
    <div class="relative w-full h-[520px] sm:h-[580px] lg:h-[620px] rounded-[2rem] sm:rounded-[2.5rem] overflow-hidden shadow-xl bg-[#1a3825]">
      
      <!-- Background Real Image -->
      <img
        src="/images/hero-stage.jpg"
        alt="Panggung Acara Modern & Profesional Aethel Event Organizer di Malang dan Kediri"
        class="absolute inset-0 w-full h-full object-cover object-center transform transition-transform duration-700 hover:scale-105"
        loading="eager"
      />

      <!-- Elegant Sage & Dark Emerald Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#112418]/95 via-[#183624]/65 to-[#1c3e29]/40 sm:bg-gradient-to-r sm:from-[#112418]/95 sm:via-[#183624]/75 sm:to-transparent"></div>

      <!-- Real HTML Content Overlay -->
      <div class="relative z-10 h-full p-6 sm:p-12 lg:p-16 flex flex-col justify-end sm:justify-center max-w-2xl text-white">
        
        <!-- Main Headline -->
        <h1 class="text-[1.75rem] sm:text-5xl lg:text-[3.75rem] font-extrabold tracking-tight leading-[1.15] mb-4 text-white break-words">
          Discover Your <br class="hidden sm:inline" />
          <span class="text-emerald-300 font-sans italic font-normal">Extraordinary</span> Event.
        </h1>

        <!-- Subheadline / Value Proposition -->
        <p class="text-sm sm:text-base text-emerald-100/90 font-normal leading-relaxed mb-8 max-w-lg">
          Wujudkan momen berharga tanpa rasa cemas. Dari Corporate Gathering di Kota Wisata Batu, Konferensi Nasional di Malang, hingga Wedding & Gala Dinner megah di Kediri.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/kontak"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-[#2d553b] hover:bg-[#1f3f2a] text-white text-sm font-semibold transition-all shadow-md hover:shadow-lg hover:scale-102 border border-emerald-400/30"
          >
            <span>Ajukan Rencana Acara</span>
            <svg class="w-4 h-4 text-emerald-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="/portofolio"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-white/95 hover:bg-white text-[#1b3825] text-sm font-semibold transition-all backdrop-blur-md shadow-xs hover:scale-102"
          >
            <span>Lihat Portofolio</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
