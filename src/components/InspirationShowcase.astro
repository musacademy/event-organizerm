---
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 reveal-on-scroll">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    
    <!-- Left description -->
    <div class="lg:col-span-5">
      <span class="inline-block text-xs font-bold tracking-widest uppercase text-[#2d553b] bg-[#eaf2eb] px-3.5 py-1.5 rounded-full mb-3">
        Inspirasi Konsep Acara
      </span>
      <h2 class="text-2xl sm:text-4xl font-sans font-extrabold text-[#1b3825] leading-tight mb-4">
        100+ Konsep Acara Unik & Estetik
      </h2>
      <p class="text-xs sm:text-sm text-[#546b5a] leading-relaxed mb-6">
        Setiap acara memiliki cerita unik. Kami memadukan estetika ruang modern bernuansa sage-minimalis, dekorasi botani lokal, dan teknologi panggung untuk menciptakan pengalaman yang tak terlupakan bagi tamu Anda di Malang dan Kediri.
      </p>
      
      <div class="flex items-center gap-4">
        <a
          href="/galeri"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#2d553b] hover:bg-[#1a3825] text-white text-xs font-bold transition-all shadow-xs"
        >
          <span>Lihat Galeri Konsep</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href="/portofolio"
          class="text-xs font-bold text-[#2d553b] hover:underline"
        >
          Lihat Dokumentasi Proyek &rarr;
        </a>
      </div>
    </div>

    <!-- Right 3 tall rounded cards matching reference design -->
    <div class="lg:col-span-7 grid grid-cols-3 gap-3 sm:gap-4">
      <div class="rounded-3xl overflow-hidden border border-[#e1eae2] h-72 sm:h-96 group shadow-xs">
        <img
          src="/images/wedding-reception.jpg"
          alt="Outdoor botanical wedding banquet"
          class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700"
          loading="lazy"
        />
      </div>

      <div class="rounded-3xl overflow-hidden border border-[#e1eae2] h-72 sm:h-96 group shadow-xs translate-y-3">
        <img
          src="/images/corporate-malang.jpg"
          alt="Corporate conference stage in Malang"
          class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700"
          loading="lazy"
        />
      </div>

      <div class="rounded-3xl overflow-hidden border border-[#e1eae2] h-72 sm:h-96 group shadow-xs">
        <img
          src="/images/gathering-batu.jpg"
          alt="Outdoor team gathering in Batu resort"
          class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700"
          loading="lazy"
        />
      </div>
    </div>

  </div>
</section>
