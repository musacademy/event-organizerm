---
import type { PortfolioItem } from '../../data/portfolio';

interface Props {
  item: PortfolioItem;
}

const { item } = Astro.props;
---

<a
  href={`/portofolio/${item.slug}`}
  class="portfolio-card bg-white rounded-3xl overflow-hidden border border-[#e2ece4] shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group cursor-pointer block"
  data-city={item.city.toLowerCase()}
  data-cat={item.category.toLowerCase()}
>
  <div>
    <div class="relative w-full h-52 overflow-hidden bg-gray-100">
      <img
        src={item.featuredImage}
        alt={item.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        decoding="async"
      />
      <span class="absolute top-3 left-3 px-3 py-1 bg-[#2d553b] text-white text-[10px] font-bold rounded-full shadow-xs">
        {item.category}
      </span>
      <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-xs px-2.5 py-1 rounded-full text-[10px] font-medium text-[#2d553b]">
        {item.location}
      </div>
    </div>

    <div class="p-4 sm:p-6">
      <div class="text-[11px] text-[#63806b] mb-1 font-medium">{item.date} &bull; {item.attendees}</div>
      <h2 class="text-base font-bold text-[#1b3825] group-hover:text-[#2d553b] transition-colors leading-snug line-clamp-1 mb-2">
        {item.title}
      </h2>
      <p class="text-xs text-[#526a58] leading-relaxed line-clamp-2 mb-4">
        {item.description}
      </p>

      <!-- Services provided chips -->
      <div class="flex flex-wrap gap-1.5">
        {item.servicesProvided.slice(0, 3).map((svc) => (
          <span class="text-[10px] bg-[#edf4ee] text-[#2d553b] px-2 py-0.5 rounded-md font-medium">
            {svc}
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="p-4 sm:p-6 pt-3 sm:pt-4 border-t border-[#edf4ee] flex items-center justify-between gap-2">
    <span class="text-[11px] text-[#698570] font-medium truncate">Klien: {item.client}</span>
    <span class="text-xs font-bold text-[#2d553b] group-hover:underline inline-flex items-center gap-1 shrink-0">
      <span>Lihat Detail</span>
      <span class="group-hover:translate-x-1 transition-transform duration-200">&rarr;</span>
    </span>
  </div>
</a>
