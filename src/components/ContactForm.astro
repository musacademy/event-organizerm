---
import { businessInfo } from '../data/business';

interface Props {
  defaultLocation?: 'Malang' | 'Kediri' | 'Wilayah lain' | 'Belum ditentukan';
  headline?: string;
  subheadline?: string;
}

const {
  defaultLocation = 'Malang',
  headline = 'Ajukan Rencana & Konsultasi Acara Anda',
  subheadline = 'Diskusikan konsep, kebutuhan teknis, dan rancangan anggaran acara bersama tim perencana profesional kami.',
} = Astro.props;
---

<section id="konsultasi" class="max-w-4xl mx-auto px-4 sm:px-6 py-12 reveal-on-scroll">
  <div class="bg-white rounded-[2.5rem] p-6 sm:p-10 border border-[#e2ece4] shadow-lg relative overflow-hidden">
    
    <div class="text-center max-w-xl mx-auto mb-8">
      <h2 class="text-2xl sm:text-3xl font-sans font-extrabold text-[#1b3825]">
        {headline}
      </h2>
      <p class="text-xs sm:text-sm text-[#546b5a] mt-2">
        {subheadline}
      </p>
    </div>

    <form id="event-inquiry-form" class="space-y-6">
      
      <!-- Personal & Contact Info -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="form-name" class="block text-xs font-bold text-[#1b3825] mb-1.5">
            Nama Lengkap / PIC Acara <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="form-name"
            required
            placeholder="Contoh: Bpk. Hendra Kusuma / dr. Nabila"
            class="w-full text-xs font-medium rounded-xl border border-[#d6e3d8] bg-[#f9fbf9] p-3 focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] outline-none"
          />
        </div>

        <div>
          <label for="form-org" class="block text-xs font-bold text-[#1b3825] mb-1.5">
            Nama Perusahaan / Komunitas (Opsional)
          </label>
          <input
            type="text"
            id="form-org"
            placeholder="Contoh: PT Citra Sejahtera / Pribadi"
            class="w-full text-xs font-medium rounded-xl border border-[#d6e3d8] bg-[#f9fbf9] p-3 focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] outline-none"
          />
        </div>

        <div>
          <label for="form-wa" class="block text-xs font-bold text-[#1b3825] mb-1.5">
            Nomor WhatsApp / HP Aktif <span class="text-red-500">*</span>
          </label>
          <input
            type="tel"
            id="form-wa"
            required
            placeholder="Contoh: 081234567890"
            class="w-full text-xs font-medium rounded-xl border border-[#d6e3d8] bg-[#f9fbf9] p-3 focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] outline-none"
          />
        </div>

        <div>
          <label for="form-email" class="block text-xs font-bold text-[#1b3825] mb-1.5">
            Alamat Email (Opsional)
          </label>
          <input
            type="email"
            id="form-email"
            placeholder="Contoh: hendra@perusahaan.co.id"
            class="w-full text-xs font-medium rounded-xl border border-[#d6e3d8] bg-[#f9fbf9] p-3 focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] outline-none"
          />
        </div>
      </div>

      <!-- Event Details & Location (Mandatory PRD Section 9) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-[#edf4ee]">
        
        <!-- Location Selection fulfilling PRD 9 -->
        <div>
          <label for="form-location" class="block text-xs font-bold text-[#1b3825] mb-1.5">
            Lokasi Rencana Acara <span class="text-red-500">*</span>
          </label>
          <select
            id="form-location"
            required
            class="w-full text-xs font-medium rounded-xl border border-[#d6e3d8] bg-[#f9fbf9] p-3 focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] outline-none"
          >
            <option value="Malang" selected={defaultLocation === 'Malang'}>Malang (Kota Malang / Kab. Malang / Kota Batu)</option>
            <option value="Kediri" selected={defaultLocation === 'Kediri'}>Kediri (Kota Kediri / Kab. Kediri)</option>
            <option value="Wilayah lain" selected={defaultLocation === 'Wilayah lain'}>Wilayah lain (Jawa Timur & sekitarnya)</option>
            <option value="Belum ditentukan" selected={defaultLocation === 'Belum ditentukan'}>Belum ditentukan (Masih eksplorasi)</option>
          </select>
          <span class="text-[10px] text-[#63806a] block mt-1">Kami juga melayani area luar Malang & Kediri sesuai kesepakatan.</span>
        </div>

        <!-- Event Type -->
        <div>
          <label for="form-type" class="block text-xs font-bold text-[#1b3825] mb-1.5">
            Jenis Acara <span class="text-red-500">*</span>
          </label>
          <select
            id="form-type"
            required
            class="w-full text-xs font-medium rounded-xl border border-[#d6e3d8] bg-[#f9fbf9] p-3 focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] outline-none"
          >
            <option value="Corporate Event">Corporate Event / Gala Dinner / Awarding</option>
            <option value="Wedding Organizer">Wedding Organizer (Intimate / Luxury)</option>
            <option value="Seminar & Conference">Seminar, Conference & Workshop</option>
            <option value="Gathering Perusahaan">Gathering Perusahaan & Outbound</option>
            <option value="Concert & Festival">Concert & Festival Musik</option>
            <option value="Exhibition & Brand Activation">Exhibition & Brand Activation</option>
            <option value="Birthday & Private Event">Birthday Party & Private Celebration</option>
            <option value="Graduation Event">Graduation Event / Wisuda</option>
            <option value="Community Event">Community Event</option>
            <option value="Custom Event">Custom Event Khusus Lainnya</option>
          </select>
        </div>

        <!-- Optional Venue / Address field (PRD Section 9) -->
        <div>
          <label for="form-venue" class="block text-xs font-bold text-[#1b3825] mb-1.5">
            Nama Venue / Perkiraan Alamat (Jika Sudah Ada)
          </label>
          <input
            type="text"
            id="form-venue"
            placeholder="Contoh: Grand Mercure Malang / Grand Surya Kediri / Belum Ada"
            class="w-full text-xs font-medium rounded-xl border border-[#d6e3d8] bg-[#f9fbf9] p-3 focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] outline-none"
          />
        </div>

        <!-- Date & Guest Count -->
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label for="form-date" class="block text-xs font-bold text-[#1b3825] mb-1.5">
              Rencana Tanggal
            </label>
            <input
              type="date"
              id="form-date"
              class="w-full text-xs font-medium rounded-xl border border-[#d6e3d8] bg-[#f9fbf9] p-3 focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] outline-none"
            />
          </div>
          <div>
            <label for="form-guests" class="block text-xs font-bold text-[#1b3825] mb-1.5">
              Jumlah Tamu
            </label>
            <input
              type="text"
              id="form-guests"
              placeholder="Contoh: 200 Orang"
              class="w-full text-xs font-medium rounded-xl border border-[#d6e3d8] bg-[#f9fbf9] p-3 focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] outline-none"
            />
          </div>
        </div>

      </div>

      <!-- Notes / Specific Needs -->
      <div>
        <label for="form-notes" class="block text-xs font-bold text-[#1b3825] mb-1.5">
          Ceritakan Konsep atau Kebutuhan Khusus Acara
        </label>
        <textarea
          id="form-notes"
          rows="3"
          placeholder="Jelaskan kebutuhan panggung, dekorasi, rundown, pengisi acara, atau rentang anggaran yang Anda rencanakan..."
          class="w-full text-xs font-medium rounded-xl border border-[#d6e3d8] bg-[#f9fbf9] p-3 focus:border-[#2d553b] focus:ring-1 focus:ring-[#2d553b] outline-none"
        ></textarea>
      </div>

      <!-- Submission Status Alert -->
      <div id="form-success-alert" class="hidden bg-[#edf7ef] border border-[#a2d1ac] rounded-2xl p-4 text-xs text-[#1e4e2a]">
        <div class="flex items-center gap-2 font-bold mb-1">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>Pengajuan Acara Anda Berhasil Disimpan!</span>
        </div>
        <p class="leading-relaxed">
          Konsultan Aethel Events akan segera menghubungi Anda melalui WhatsApp untuk tindak lanjut jadwal kickoff & proposal awal.
        </p>
      </div>

      <!-- Submit & WhatsApp Direct Buttons -->
      <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
        <button
          type="submit"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-[#2d553b] hover:bg-[#1b3825] text-white text-xs sm:text-sm font-bold transition-all shadow-md hover:shadow-lg hover:scale-101 cursor-pointer"
        >
          Kirim Pengajuan Acara
        </button>

        <button
          type="button"
          id="btn-direct-wa"
          class="w-full sm:w-auto px-6 py-3.5 rounded-full bg-white hover:bg-[#edf4ee] text-[#2d553b] border border-[#2d553b] text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current text-[#2d553b]" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z" />
          </svg>
          <span>Kirim Langsung via WhatsApp</span>
        </button>
      </div>

    </form>

  </div>
</section>

<script define:vars={{ whatsappNumber: businessInfo.whatsapp }}>
  function setupContactForm() {
    const form = document.getElementById('event-inquiry-form') as HTMLFormElement;
    const successAlert = document.getElementById('form-success-alert');
    const directWaBtn = document.getElementById('btn-direct-wa');

    function collectFormData() {
      const name = (document.getElementById('form-name') as HTMLInputElement)?.value || '';
      const org = (document.getElementById('form-org') as HTMLInputElement)?.value || '-';
      const wa = (document.getElementById('form-wa') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('form-email') as HTMLInputElement)?.value || '-';
      const location = (document.getElementById('form-location') as HTMLSelectElement)?.value || 'Malang';
      const type = (document.getElementById('form-type') as HTMLSelectElement)?.value || 'Corporate Event';
      const venue = (document.getElementById('form-venue') as HTMLInputElement)?.value || '-';
      const date = (document.getElementById('form-date') as HTMLInputElement)?.value || 'Fleksibel';
      const guests = (document.getElementById('form-guests') as HTMLInputElement)?.value || '-';
      const notes = (document.getElementById('form-notes') as HTMLTextAreaElement)?.value || '-';

      return { name, org, wa, email, location, type, venue, date, guests, notes };
    }

    function getWhatsAppUrl(data: ReturnType<typeof collectFormData>) {
      const text = `Halo Aethel Events, saya ingin mengajukan rencana acara:\n\n` +
        `*Nama / PIC:* ${data.name || 'Calon Klien'}\n` +
        `*Perusahaan / Komunitas:* ${data.org}\n` +
        `*No WhatsApp:* ${data.wa}\n` +
        `*Email:* ${data.email}\n` +
        `*Lokasi Acara:* ${data.location}\n` +
        `*Jenis Acara:* ${data.type}\n` +
        `*Venue:* ${data.venue}\n` +
        `*Rencana Tanggal:* ${data.date}\n` +
        `*Perkiraan Tamu:* ${data.guests}\n` +
        `*Catatan Khusus:* ${data.notes}\n\n` +
        `Mohon konfirmasi ketersediaan tim dan langkah konsultasi selanjutnya. Terima kasih!`;
      return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
    }

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = collectFormData();
        if (successAlert) {
          successAlert.classList.remove('hidden');
        }
        setTimeout(() => {
          window.open(getWhatsAppUrl(data), '_blank');
        }, 700);
      });
    }

    if (directWaBtn) {
      directWaBtn.addEventListener('click', () => {
        const data = collectFormData();
        window.open(getWhatsAppUrl(data), '_blank');
      });
    }
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
