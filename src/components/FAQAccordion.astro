---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs?: FAQItem[];
  title?: string;
  subtitle?: string;
}

const defaultFaqs: FAQItem[] = [
  {
    question: 'Apa saja wilayah jangkauan operasional Halo Malang Event Organizer?',
    answer: 'Fokus utama kami adalah Malang Raya (Kota Malang, Kabupaten Malang, Kota Wisata Batu) dan Kediri (Kota Kediri & Kabupaten Kediri). Kami juga melayani area sekitar seperti Blitar, Jombang, Pasuruan, dan kota-kota lain di Jawa Timur sesuai kesepakatan dan kebutuhan proyek.'
  },
  {
    question: 'Jenis acara apa saja yang dapat ditangani oleh Halo Malang?',
    answer: 'Kami tidak membatasi kategori acara. Layanan kami mencakup Corporate Event & Awarding Night, Wedding Organizer, Seminar & Conference, Gathering Perusahaan & Outbound, Festival Musik & Konser, Pameran / Brand Activation, Birthday Party, Wisuda, hingga Custom Event yang dirancang khusus.'
  },
  {
    question: 'Bagaimana tahapan konsultasi dan perencanaan hingga hari-H acara?',
    answer: 'Tahapan dimulai dari: (1) Free Kickoff Consultation via WhatsApp atau pertemuan langsung, (2) Penyusunan Konsep & Proposal Itemized Budget terinci, (3) Survey venue bersama di Malang atau Kediri, (4) Technical meeting & koordinasi vendor, (5) Gladi bersih dan eksekusi hari-H dengan pendampingan tim LO & stage manager.'
  },
  {
    question: 'Apakah Halo Malang dapat membantu pengurusan perizinan dan booking venue?',
    answer: 'Ya, kami memiliki tim hubungan kelembagaan yang terbiasa mengurus izin keramaian dari kepolisian setempat, satpol PP, dinas terkait, serta memegang jaringan rekanan resmi ballroom hotel dan resort di Malang Raya dan Kediri.'
  },
  {
    question: 'Bagaimana transparansi anggaran dan sistem pembayaran kerja sama?',
    answer: 'Kami menerapkan transparansi penuh tanpa mark-up tersembunyi. Setiap rincian biaya panggung, sound, konsumsi, dan manajemen dijabarkan dalam format itemized. Pembayaran dilakukan secara bertahap sesuai milestone persiapan acara.'
  }
];

const {
  faqs = defaultFaqs,
  title = 'Pertanyaan yang Sering Diajukan (FAQ)',
  subtitle = 'Informasi seputar layanan, jangkauan operasional, dan alur kerja penyelenggaraan acara.'
} = Astro.props;
---

<section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 reveal-on-scroll">
  <div class="text-center max-w-xl mx-auto mb-8">
    <h2 class="text-2xl sm:text-3xl font-sans font-extrabold text-[#1b3825]">
      {title}
    </h2>
    <p class="text-xs sm:text-sm text-[#546b5a] mt-2">
      {subtitle}
    </p>
  </div>

  <div class="space-y-3 faq-accordion-container" id="faq-list">
    {faqs.map((faq, idx) => (
      <details
        class="group bg-white rounded-2xl border border-[#e2ece4] overflow-hidden shadow-xs hover:border-[#2d553b]/30 transition-all duration-200"
        open={idx === 0}
      >
        <summary class="cursor-pointer list-none w-full px-5 py-4.5 text-left flex items-center justify-between text-xs sm:text-sm font-bold text-[#1b3825] group-hover:text-[#2d553b] focus:outline-none select-none transition-colors [&::-webkit-details-marker]:hidden">
          <span class="pr-4">{faq.question}</span>
          <div class="w-7 h-7 rounded-xl bg-[#f0f6f1] text-[#2d553b] flex items-center justify-center shrink-0 group-hover:bg-[#2d553b] group-hover:text-white transition-colors">
            <svg class="w-4 h-4 transform transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </summary>
        <div class="px-5 pb-5 text-xs sm:text-sm text-[#526a58] leading-relaxed border-t border-[#edf4ee] pt-3.5">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>
</section>

<script>
  function setupAccordion() {
    document.querySelectorAll('.faq-accordion-container').forEach((container) => {
      const detailsList = container.querySelectorAll('details');
      detailsList.forEach((detail) => {
        detail.addEventListener('click', (e) => {
          const target = e.target;
          if (target && target.closest('summary') && !detail.open) {
            detailsList.forEach((other) => {
              if (other !== detail) {
                other.removeAttribute('open');
              }
            });
          }
        });
      });
    });
  }

  setupAccordion();
  document.addEventListener('astro:page-load', setupAccordion);
</script>
