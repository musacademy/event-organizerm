---
const features = [
  {
    title: 'Easy Planning & Solusi All-in-One',
    description: 'Manajemen konsep, perizinan, panggung, hingga rundown acara terpadu.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />`,
    delayClass: 'stagger-1'
  },
  {
    title: 'Vendor & Venue Terkurasi',
    description: 'Rekanan hotel, ballroom, resort Batu & venue Kediri terpercaya.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
    delayClass: 'stagger-2'
  },
  {
    title: 'Konsultasi & Pendampingan 24/7',
    description: 'Event consultant responsif siap mendiskusikan kebutuhan acara Anda.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />`,
    delayClass: 'stagger-3'
  },
  {
    title: 'Transparansi Biaya (No Hidden Cost)',
    description: 'Proposal anggaran itemized rinci, tanpa biaya siluman di akhir acara.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
    delayClass: 'stagger-4'
  },
];
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {features.map((feat) => (
      <div class={`reveal-on-scroll ${feat.delayClass} bg-white rounded-3xl p-5 border border-[#e3ece4] shadow-xs hover:border-[#2d553b] transition-all duration-300 group hover:-translate-y-1`}>
        <div class="w-12 h-12 rounded-2xl bg-[#edf5ef] group-hover:bg-[#2d553b] flex items-center justify-center text-[#2d553b] group-hover:text-white transition-colors mb-4">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={feat.icon} />
        </div>
        <h3 class="text-sm font-bold text-[#1b3825] mb-1.5 leading-snug">{feat.title}</h3>
        <p class="text-xs text-[#526a58] leading-relaxed">{feat.description}</p>
      </div>
    ))}
  </div>
</section>
