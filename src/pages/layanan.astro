---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LayananHero from '../components/layanan/LayananHero.astro';
import DualHubSection from '../components/layanan/DualHubSection.astro';
import ServiceCategories from '../components/layanan/ServiceCategories.astro';
import VenuePartners from '../components/layanan/VenuePartners.astro';
import FeaturedPortfolioSection from '../components/layanan/FeaturedPortfolioSection.astro';
import { unifiedFaqs } from '../data/layanan';
import { businessInfo } from '../data/business';
---

<Layout
  title="Layanan Event Organizer Malang & Kediri | Halo Malang"
  description="Layanan penyelenggara acara profesional terpadu di wilayah Malang Raya, Kota Wisata Batu, dan Kediri. Mengelola corporate gathering, wedding, seminar, festival, dan pameran."
  keywords="Event Organizer Malang Kediri, Jasa EO Malang, EO Kediri, Event Organizer Terpadu Jawa Timur, Wedding Organizer Malang Kediri, Gathering Outbound Batu"
  currentPath="/layanan"
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Layanan Malang & Kediri', url: '/layanan' }
  ]}
>
  <!-- Hero Section Unified -->
  <LayananHero />

  <!-- Dual Hub Value Proposition -->
  <DualHubSection />

  <!-- Kategori Layanan Utama -->
  <ServiceCategories />

  <!-- Venue Partners in Both Cities -->
  <VenuePartners />

  <!-- Featured Portfolio Showcase (Both Cities) -->
  <FeaturedPortfolioSection />

  <!-- Unified FAQ Section -->
  <div class="mt-8">
    <FAQAccordion
      faqs={unifiedFaqs}
      title="Pertanyaan Seputar Layanan Terpadu Malang & Kediri"
      subtitle="Informasi seputar operasional dual hub, logistik peralatan, venue rekanan, dan alur pemesanan."
    />
  </div>

  <!-- Consultation Contact Form Section -->
  <section id="konsultasi" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-5 bg-white p-6 sm:p-8 rounded-[2rem] border border-[#e2ece4] shadow-xs">
        <h3 class="text-2xl font-sans font-extrabold text-[#1b3825] mb-3">
          Rencanakan Acara Anda Bersama Kami
        </h3>
        <p class="text-xs sm:text-sm text-[#4e6654] leading-relaxed mb-6">
          Isi formulir rencana acara untuk mendapatkan proposal itemized budget dan konsep awal secara gratis dalam 1x24 jam kerja.
        </p>

        <div class="space-y-4 pt-4 border-t border-[#edf4ee]">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#2d553b] block mb-1">
              Kantor Pusat Malang:
            </span>
            <p class="text-xs text-[#48614e]">Jl. Besar Ijen No. 42, Klojen, Kota Malang 65115</p>
          </div>
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#2d553b] block mb-1">
              Hub Operasional Kediri:
            </span>
            <p class="text-xs text-[#48614e]">Jl. Dhoho No. 88, Kemasan, Kota Kediri 64129</p>
          </div>
          <div class="pt-2">
            <a
              href={`https://wa.me/${businessInfo.whatsapp}?text=Halo%20Halo%20Malang,%20saya%20ingin%20konsultasi%20acara%20di%20Malang/Kediri.`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 px-4 bg-[#2d553b] hover:bg-[#1a3825] text-white rounded-full text-xs font-bold transition-all shadow-xs flex items-center justify-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
              <span>Hubungi via WhatsApp Instan</span>
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <ContactForm headline="Formulir Konsultasi Acara Malang & Kediri" />
      </div>
    </div>
  </section>
</Layout>
