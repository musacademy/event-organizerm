---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { portfolioData } from '../data/portfolio';
import { businessInfo } from '../data/business';

// Unified featured portfolio from both cities
const featuredProjects = portfolioData.slice(0, 6);

const unifiedFaqs = [
  {
    question: 'Bagaimana Aethel Events menghandle acara di Malang dan Kediri dalam 1 proyek?',
    answer: 'Kami mengoperasikan dua hub resmi: Kantor Utama di Malang (Kawasan Ijen) dan Hub Operasional di Kediri (Kawasan Dhoho). Dengan sistem manajemen terpusat, tim produksi, show management, dan gudang peralatan kami siap beroperasi di kedua wilayah tanpa kendala koordinasi atau biaya mobilisasi luar kota yang membebani klien.'
  },
  {
    question: 'Apakah ada perbedaan kualitas layanan antara acara di Malang dan di Kediri?',
    answer: 'Sama sekali tidak ada perbedaan. Seluruh acara di Malang Raya maupun Kediri ditangani dengan SOP kualitas yang sama: rancangan 3D layout presisi, tim show director berpengalaman, sound system berstandar profesional, dan pendampingan LO dedicated sepanjang acara.'
  },
  {
    question: 'Bisakah Aethel mengelola acara multi-kota atau roadshow di Jawa Timur?',
    answer: 'Tentu bisa. Karena memiliki basis operasional kuat di Malang dan Kediri, kami sangat ideal untuk menangani rangkaian roadshow korporasi, aktivasi brand, atau pameran yang berpindah antara Malang, Batu, Kediri, Blitar, hingga Jombang dengan satu kontrak kerja sama yang efisien.'
  },
  {
    question: 'Venue mana saja yang menjadi rekanan resmi Aethel di Malang dan Kediri?',
    answer: 'Di Malang Raya: Grand Mercure Mirama, Hotel Savana, The Singhasari Resort Batu, Kusuma Agrowisata, dan Malang Creative Center. Di Kediri: Grand Surya Hotel, Insumo Kediri Convention Centre, Lotus Garden Hotel, serta area publik seperti Simpang Lima Gumul (SLG).'
  },
  {
    question: 'Berapa lama persiapan ideal dan berapa batas minimal kapasitas peserta?',
    answer: 'Kami melayani acara mulai dari intimate gathering (30–50 pax) hingga festival ribuan penonton. Waktu persiapan ideal adalah 3–6 minggu untuk acara corporate/wedding, dan 2–3 bulan untuk festival musik atau expo besar.'
  }
];

const serviceCategories = [
  {
    title: 'Corporate Gathering & Employee Outbound',
    description: 'Program keakraban perusahaan, outbound games di Batu, hingga gala dinner mewah di Malang dan Kediri.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z'
  },
  {
    title: 'Seminar, Conference & Awarding Night',
    description: 'Manajemen simposium akademis dan malam apresiasi korporat dengan registrasi digital barcode & LED screen 4K.',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4'
  },
  {
    title: 'Wedding Organizer & Resepsi Intimate',
    description: 'Pernikahan elegan bernuansa botanical-sage di villa pegunungan Batu atau grand luxury ballroom di Kediri.',
    icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z'
  },
  {
    title: 'Festival Musik, Konser & Expo Publik',
    description: 'Produksi panggung rigging truss kokoh, tata cahaya moving beam, tata suara line-array, dan perizinan crowd control.',
    icon: 'M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3'
  },
  {
    title: 'Brand Activation & Product Launching',
    description: 'Instalasi pameran interaktif di mall, peluncuran produk inovatif, dan publikasi media terarah di Jawa Timur.',
    icon: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z'
  },
  {
    title: 'Custom Event & Private Celebration',
    description: 'Pesta ulang tahun tematik, anniversary perusahaan, reuni akbar, dan wisuda dengan sentuhan personal unik.',
    icon: 'M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.701 2.701 0 00-1.5-.454M9 6v2m3-2v2m3-2v2M9 3h.01M12 3h.01M15 3h.01M21 21v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v7h18zm-3-9v-2a2 2 0 00-2-2H8a2 2 0 00-2 2v2h10z'
  }
];

const venueHighlights = [
  {
    region: 'Malang & Kota Batu',
    venues: ['Grand Mercure Malang Mirama', 'Hotel Savana & Convention', 'The Singhasari Resort Batu', 'Kusuma Agrowisata Resort', 'Malang Creative Center (MCC)'],
    badge: 'Hub Utama'
  },
  {
    region: 'Kediri & Sekitarnya',
    venues: ['Grand Surya Hotel Kediri', 'Insumo Kediri Convention Centre (IKCC)', 'Lotus Garden Hotel', 'Simpang Lima Gumul (SLG)', 'Area Komersial Dhoho'],
    badge: 'Hub Operasional'
  }
];
---

<Layout
  title="Layanan Event Organizer Malang & Kediri | Aethel Events"
  description="Layanan penyelenggara acara profesional terpadu di wilayah Malang Raya, Kota Wisata Batu, dan Kediri. Mengelola corporate gathering, wedding, seminar, festival, dan pameran."
  keywords="Event Organizer Malang Kediri, Jasa EO Malang, EO Kediri, Event Organizer Terpadu Jawa Timur, Wedding Organizer Malang Kediri, Gathering Outbound Batu"
  currentPath="/layanan"
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Layanan Malang & Kediri', url: '/layanan' }
  ]}
>
  <!-- Hero Section Unified -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-8">
    <div class="relative bg-white rounded-[2rem] sm:rounded-[2.75rem] border border-[#e2ece4] overflow-hidden shadow-xs p-3 sm:p-5">
      <div class="relative w-full h-[480px] sm:h-[540px] rounded-[1.75rem] sm:rounded-[2.25rem] overflow-hidden">
        <img
          src="/images/corporate-malang.jpg"
          alt="Layanan Event Organizer Terpadu Malang dan Kediri"
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#13271a]/95 via-[#1a3825]/65 to-black/35"></div>

        <div class="absolute inset-0 p-6 sm:p-12 lg:p-16 flex flex-col justify-end max-w-3xl text-white">
          <!-- Hub Status Pill -->
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold text-emerald-100 border border-white/20">
              <span class="w-2 h-2 rounded-full bg-emerald-300"></span>
              Malang (Head Office)
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold text-emerald-100 border border-white/20">
              <span class="w-2 h-2 rounded-full bg-emerald-300"></span>
              Kediri (Operational Hub)
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold font-sans tracking-tight leading-tight mb-4 text-white">
            Solusi Event Organizer Terpadu untuk Malang & Kediri.
          </h1>

          <p class="text-xs sm:text-sm text-[#d8ebd9] font-normal leading-relaxed mb-6 max-w-xl">
            Satu tim terintegrasi untuk seluruh kebutuhan acara Anda. Dari sejuknya venue Kota Malang & Batu hingga pesatnya aktivitas korporat dan festival di Kediri, kami hadirkan eksekusi panggung, logistik, dan show management tanpa kompromi.
          </p>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="#konsultasi"
              class="px-6 py-3 rounded-full bg-[#2d553b] hover:bg-[#1a3825] text-white text-xs sm:text-sm font-semibold transition-all shadow-md border border-emerald-400/30"
            >
              Konsultasi Acara Sekarang
            </a>
            <a
              href="#kategori-layanan"
              class="px-5 py-3 rounded-full bg-white/90 hover:bg-white text-[#1b3825] text-xs font-semibold transition-all"
            >
              Lihat Kategori Layanan &darr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dual Hub Value Proposition -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7">
        <h2 class="text-2xl sm:text-3xl font-sans font-extrabold text-[#1b3825] leading-tight mb-4">
          Mengapa 1 Project Terpadu Memudahkan Penyelenggaraan Acara Anda?
        </h2>
        <div class="space-y-3 text-xs sm:text-sm text-[#4e6654] leading-relaxed">
          <p>
            Banyak perusahaan, institusi, maupun keluarga memiliki mobilitas dan agenda yang melibatkan kawasan <strong>Malang Raya (termasuk Kota Batu)</strong> dan <strong>Kediri</strong>. Memisahkan vendor acara di dua kota yang berdekatan ini sering kali memicu pembengkakan biaya, ketidaksinkronan konsep visual, serta kendala koordinasi.
          </p>
          <p>
            Melalui Aethel Events, Anda mendapatkan <strong>satu payung manajemen profesional</strong> yang menaungi seluruh kebutuhan teknis di kedua kota. Kami memiliki gudang inventaris sound line-array, lighting, dan rigging truss mandiri di Malang dan Kediri, memastikan efisiensi biaya logistik dan kecepatan respon tim lapangan.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-6">
          <div class="bg-white p-4 rounded-2xl border border-[#e2ece4] text-center">
            <span class="block text-xl font-bold text-[#2d553b]">120+</span>
            <span class="text-[11px] text-[#607966]">Event Malang & Kediri</span>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-[#e2ece4] text-center">
            <span class="block text-xl font-bold text-[#2d553b]">40+</span>
            <span class="text-[11px] text-[#607966]">Venue Rekanan Kedua Kota</span>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-[#e2ece4] text-center col-span-2 sm:col-span-1">
            <span class="block text-xl font-bold text-[#2d553b]">1 Titik</span>
            <span class="text-[11px] text-[#607966]">Koordinasi & Kontrak Resmi</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 grid grid-cols-2 gap-3">
        <div class="rounded-3xl overflow-hidden border border-[#e2ece4] h-56 sm:h-68 shadow-xs">
          <img src="/images/gathering-batu.jpg" alt="Gathering di Batu Malang" class="w-full h-full object-cover" />
        </div>
        <div class="rounded-3xl overflow-hidden border border-[#e2ece4] h-56 sm:h-68 shadow-xs translate-y-4">
          <img src="/images/stage-concert.jpg" alt="Stage Rigging Konser di Kediri" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Kategori Layanan Utama -->
  <section id="kategori-layanan" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="bg-[#edf4ee] rounded-[2.5rem] p-6 sm:p-12 border border-[#d6e5d9]">
      <div class="max-w-2xl mb-10">
        <h3 class="text-2xl sm:text-3xl font-sans font-extrabold text-[#1b3825] mb-3">
          Cakupan Layanan Penyelenggaraan Acara
        </h3>
        <p class="text-xs sm:text-sm text-[#546e5a] leading-relaxed">
          Dari skala intimate hingga perhelatan akbar, seluruh divisi show management, dekorasi, perizinan, dan audio-visual ditangani dengan standar mutu tinggi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {serviceCategories.map((service) => (
          <div class="bg-white p-6 rounded-3xl border border-[#dce8df] shadow-xs hover:shadow-md transition-all">
            <div class="w-12 h-12 rounded-2xl bg-[#e3efe5] flex items-center justify-center text-[#2d553b] mb-4">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon} />
              </svg>
            </div>
            <h4 class="text-base font-bold text-[#1b3825] mb-2">{service.title}</h4>
            <p class="text-xs text-[#526a58] leading-relaxed">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Venue Partners in Both Cities -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h3 class="text-2xl sm:text-3xl font-sans font-extrabold text-[#1b3825]">
        Jaringan Venue Rekanan di Malang & Kediri
      </h3>
      <p class="text-xs sm:text-sm text-[#546b5a] mt-2">
        Akses kemitraan prioritas untuk kemudahan reservasi ballroom hotel, resort perbukitan, convention hall, hingga ruang terbuka publik.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {venueHighlights.map((hub) => (
        <div class="bg-white p-6 sm:p-8 rounded-[2rem] border border-[#e2ece4] shadow-xs">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#edf4ee]">
            <h4 class="text-lg font-bold text-[#1b3825]">{hub.region}</h4>
            <span class="text-xs font-semibold px-3 py-1 bg-[#eaf2eb] text-[#2d553b] rounded-full">
              {hub.badge}
            </span>
          </div>
          <ul class="space-y-2.5">
            {hub.venues.map((venue) => (
              <li class="flex items-center gap-2.5 text-xs text-[#395341]">
                <svg class="w-4 h-4 text-[#2d553b] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{venue}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Portfolio Showcase (Both Cities) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <h3 class="text-2xl sm:text-3xl font-sans font-extrabold text-[#1b3825]">
          Portofolio Proyek Pilihan di Malang & Kediri
        </h3>
        <p class="text-xs sm:text-sm text-[#546b5a] mt-1">
          Bukti nyata keandalan eksekusi acara di berbagai lokasi bergengsi Jawa Timur.
        </p>
      </div>
      <a href="/portofolio" class="text-xs font-bold text-[#2d553b] hover:underline flex items-center gap-1">
        <span>Lihat Semua Portofolio ({portfolioData.length})</span>
        <span>&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProjects.map((item) => (
        <a
          href={`/portofolio/${item.slug}`}
          class="bg-white rounded-3xl overflow-hidden border border-[#e2ece4] shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group cursor-pointer block"
        >
          <div>
            <div class="relative w-full h-48 overflow-hidden bg-gray-100">
              <img
                src={item.featuredImage}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 px-3 py-1 bg-[#2d553b] text-white text-[10px] font-bold rounded-full">
                {item.category}
              </span>
              <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-xs px-2.5 py-1 rounded-full text-[10px] font-medium text-[#2d553b]">
                {item.location}
              </div>
            </div>

            <div class="p-6">
              <div class="text-[11px] text-[#63806b] mb-1 font-medium">{item.date} &bull; {item.attendees}</div>
              <h4 class="text-sm font-bold text-[#1b3825] group-hover:text-[#2d553b] transition-colors leading-snug line-clamp-1 mb-2">
                {item.title}
              </h4>
              <p class="text-xs text-[#526a58] leading-relaxed line-clamp-2">
                {item.description}
              </p>
            </div>
          </div>

          <div class="p-6 pt-0 border-t border-[#edf4ee] flex items-center justify-between">
            <span class="text-[11px] text-[#698570]">Klien: {item.client}</span>
            <span class="text-xs font-bold text-[#2d553b] group-hover:underline inline-flex items-center gap-1">
              <span>Detail</span>
              <span class="group-hover:translate-x-1 transition-transform duration-200">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Unified FAQ Section -->
  <div class="mt-8">
    <FAQAccordion
      faqs={unifiedFaqs}
      title="Pertanyaan Seputar Layanan Terpadu Malang & Kediri"
      subtitle="Informasi seputar operasional dual hub, logistik peralatan, venue rekanan, dan alur pemesanan."
    />
  </div>

  <!-- Consultation Contact Form Section -->
  <section id="konsultasi" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-5 bg-white p-6 sm:p-8 rounded-[2rem] border border-[#e2ece4] shadow-xs">
        <h3 class="text-2xl font-sans font-extrabold text-[#1b3825] mb-3">
          Rencanakan Acara Anda Bersama Kami
        </h3>
        <p class="text-xs sm:text-sm text-[#4e6654] leading-relaxed mb-6">
          Isi formulir rencana acara untuk mendapatkan proposal itemized budget dan konsep awal secara gratis dalam 1x24 jam kerja.
        </p>

        <div class="space-y-4 pt-4 border-t border-[#edf4ee]">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#2d553b] block mb-1">
              Kantor Pusat Malang:
            </span>
            <p class="text-xs text-[#48614e]">Jl. Besar Ijen No. 42, Klojen, Kota Malang 65115</p>
          </div>
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#2d553b] block mb-1">
              Hub Operasional Kediri:
            </span>
            <p class="text-xs text-[#48614e]">Jl. Dhoho No. 88, Kemasan, Kota Kediri 64129</p>
          </div>
          <div class="pt-2">
            <a
              href={`https://wa.me/${businessInfo.whatsapp}?text=Halo%20Aethel%20Events,%20saya%20ingin%20konsultasi%20acara%20di%20Malang/Kediri.`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 px-4 bg-[#2d553b] hover:bg-[#1a3825] text-white rounded-full text-xs font-bold transition-all shadow-xs flex items-center justify-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
              <span>Hubungi via WhatsApp Instan</span>
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <ContactForm title="Formulir Konsultasi Acara Malang & Kediri" />
      </div>
    </div>
  </section>
</Layout>
