---
import Layout from '../../layouts/Layout.astro';
import { portfolioData } from '../../data/portfolio';
import FAQAccordion from '../../components/FAQAccordion.astro';

const portfolioFaqs = [
  {
    question: 'Apakah Aethel melayani acara privat dengan perjanjian kerahasiaan (NDA)?',
    answer: 'Ya, untuk acara korporat berskala internal, peluncuran produk rahasia, maupun pesta keluarga eksklusif, kami siap menandatangani Non-Disclosure Agreement (NDA) dan tidak mempublikasikan dokumentasi ke publik tanpa persetujuan tertulis.'
  },
  {
    question: 'Bisakah konsep visual dan tema acara dirancang secara custom?',
    answer: 'Tentu. Setiap proyek kami dirancang dari nol sesuai identitas brand atau preferensi personal klien. Kami memadukan moodboard visual 3D, pemilihan material dekorasi, serta tata cahaya untuk mewujudkan tema yang unik.'
  },
  {
    question: 'Apakah paket dokumentasi (foto, video cinematic, drone) sudah termasuk dalam layanan EO?',
    answer: 'Kami menyediakan opsi paket all-in-one yang mencakup fotografer profesional, video aftermovie cinematic beresolusi 4K, pilot drone tersertifikasi, hingga tim live streaming multi-kamera.'
  },
  {
    question: 'Berapa kapasitas tamu terbesar yang pernah ditangani tim Aethel?',
    answer: 'Kami telah berpengalaman mengelola acara berskala intimate (50-100 orang), corporate gathering 500+ peserta, hingga festival musik kampus dan konser publik dengan audiens lebih dari 3.000 pengunjung.'
  }
];
---

<Layout
  title="Portofolio Acara | Aethel Event Organizer Malang & Kediri"
  description="Dokumentasi proyek acara yang telah sukses diselenggarakan di Malang, Kediri, dan Kota Wisata Batu oleh tim Aethel Events."
  currentPath="/portofolio"
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Portofolio', url: '/portofolio' }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Header -->
    <div class="max-w-3xl mb-8">
      <h1 class="text-3xl sm:text-4xl font-sans font-extrabold text-[#1b3825] leading-tight mb-3">
        Portofolio Penyelenggaraan Acara
      </h1>
      <p class="text-xs sm:text-sm text-[#546b5a] leading-relaxed">
        Jelajahi rekam jejak nyata kegiatan korporat, gathering, pernikahan, seminar, dan festival yang kami kelola dengan standar terbaik di Malang dan Kediri.
      </p>
    </div>

    <!-- Filters Bar (City & Category) -->
    <div class="flex flex-wrap items-center gap-2 mb-8 pb-3 border-b border-[#e2ece4]">
      <button
        type="button"
        class="portfolio-filter active px-4 py-1.5 rounded-full text-xs font-semibold bg-[#2d553b] text-white shadow-xs border border-[#2d553b] transition-all cursor-pointer"
        data-filter="all"
      >
        Semua Proyek ({portfolioData.length})
      </button>
      <button
        type="button"
        class="portfolio-filter px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-[#415446] hover:bg-[#eaf1ec] border border-[#e1eae2] transition-all cursor-pointer"
        data-filter="malang"
      >
        Malang & Batu
      </button>
      <button
        type="button"
        class="portfolio-filter px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-[#415446] hover:bg-[#eaf1ec] border border-[#e1eae2] transition-all cursor-pointer"
        data-filter="kediri"
      >
        Kediri
      </button>
      <button
        type="button"
        class="portfolio-filter px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-[#415446] hover:bg-[#eaf1ec] border border-[#e1eae2] transition-all cursor-pointer"
        data-filter="corporate"
      >
        Corporate & Gala
      </button>
      <button
        type="button"
        class="portfolio-filter px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-[#415446] hover:bg-[#eaf1ec] border border-[#e1eae2] transition-all cursor-pointer"
        data-filter="wedding"
      >
        Wedding Organizer
      </button>
      <button
        type="button"
        class="portfolio-filter px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-[#415446] hover:bg-[#eaf1ec] border border-[#e1eae2] transition-all cursor-pointer"
        data-filter="gathering"
      >
        Gathering & Outbound
      </button>
      <button
        type="button"
        class="portfolio-filter px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-[#415446] hover:bg-[#eaf1ec] border border-[#e1eae2] transition-all cursor-pointer"
        data-filter="festival"
      >
        Festival & Konser
      </button>
    </div>

    <!-- Portfolio Grid -->
    <div id="portfolio-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {portfolioData.map((item) => (
        <a
          href={`/portofolio/${item.slug}`}
          class="portfolio-card bg-white rounded-3xl overflow-hidden border border-[#e2ece4] shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group cursor-pointer block"
          data-city={item.city.toLowerCase()}
          data-cat={item.category.toLowerCase()}
        >
          <div>
            <div class="relative w-full h-52 overflow-hidden bg-gray-100">
              <img
                src={item.featuredImage}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 px-3 py-1 bg-[#2d553b] text-white text-[10px] font-bold rounded-full shadow-xs">
                {item.category}
              </span>
              <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-xs px-2.5 py-1 rounded-full text-[10px] font-medium text-[#2d553b]">
                {item.location}
              </div>
            </div>

            <div class="p-6">
              <div class="text-[11px] text-[#63806b] mb-1 font-medium">{item.date} &bull; {item.attendees}</div>
              <h2 class="text-base font-bold text-[#1b3825] group-hover:text-[#2d553b] transition-colors leading-snug line-clamp-1 mb-2">
                {item.title}
              </h2>
              <p class="text-xs text-[#526a58] leading-relaxed line-clamp-2 mb-4">
                {item.description}
              </p>

              <!-- Services provided chips -->
              <div class="flex flex-wrap gap-1.5">
                {item.servicesProvided.slice(0, 3).map((svc) => (
                  <span class="text-[10px] bg-[#edf4ee] text-[#2d553b] px-2 py-0.5 rounded-md font-medium">
                    {svc}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="p-6 pt-0 border-t border-[#edf4ee] flex items-center justify-between">
            <span class="text-[11px] text-[#698570] font-medium">Klien: {item.client}</span>
            <span class="text-xs font-bold text-[#2d553b] group-hover:underline inline-flex items-center gap-1">
              <span>Lihat Detail</span>
              <span class="group-hover:translate-x-1 transition-transform duration-200">&rarr;</span>
            </span>
          </div>
        </a>
      ))}

      <!-- Empty State -->
      <div id="portfolio-empty-state" class="hidden py-16 text-center col-span-full">
        <div class="w-12 h-12 mx-auto rounded-full bg-[#f0f6f1] flex items-center justify-center text-[#2d553b] mb-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <p class="text-sm font-bold text-[#1b3825] mb-1">Belum ada portofolio di kategori ini</p>
        <p class="text-xs text-[#5c7763]">Pilih filter lain untuk melihat rekam jejak acara lainnya.</p>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="mt-16 pt-10 border-t border-[#e2ece4]">
      <FAQAccordion
        faqs={portfolioFaqs}
        title="Pertanyaan Seputar Portofolio & Konsep Acara"
        subtitle="Pertanyaan umum mengenai dokumentasi, kerahasiaan klien, dan kustomisasi acara di Malang & Kediri."
      />
    </div>

  </div>
</Layout>

<script is:inline>
  (function() {
    function applyFilter(filterVal) {
      if (!filterVal) filterVal = 'all';

      // 1. Update button visual states
      const btns = document.querySelectorAll('.portfolio-filter');
      btns.forEach(function(b) {
        var bVal = b.getAttribute('data-filter');
        if (bVal === filterVal) {
          b.classList.remove('bg-white', 'text-[#415446]', 'hover:bg-[#eaf1ec]', 'border-[#e1eae2]');
          b.classList.add('bg-[#2d553b]', 'text-white', 'shadow-xs', 'border-[#2d553b]', 'active');
        } else {
          b.classList.remove('bg-[#2d553b]', 'text-white', 'shadow-xs', 'border-[#2d553b]', 'active');
          b.classList.add('bg-white', 'text-[#415446]', 'hover:bg-[#eaf1ec]', 'border-[#e1eae2]');
        }
      });

      // 2. Filter portfolio cards
      const cards = document.querySelectorAll('.portfolio-card');
      var matchedCount = 0;

      cards.forEach(function(card) {
        var city = (card.getAttribute('data-city') || '').toLowerCase();
        var cat = (card.getAttribute('data-cat') || '').toLowerCase();
        var isMatch = false;

        if (filterVal === 'all') {
          isMatch = true;
        } else if (filterVal === 'malang') {
          isMatch = (city === 'malang' || city === 'batu');
        } else if (filterVal === 'kediri') {
          isMatch = (city === 'kediri');
        } else if (cat.indexOf(filterVal) !== -1) {
          isMatch = true;
        }

        if (isMatch) {
          card.style.display = 'flex';
          card.classList.remove('hidden');
          matchedCount++;
        } else {
          card.style.display = 'none';
          card.classList.add('hidden');
        }
      });

      // 3. Toggle empty state
      var emptyEl = document.getElementById('portfolio-empty-state');
      if (emptyEl) {
        if (matchedCount === 0) {
          emptyEl.classList.remove('hidden');
          emptyEl.style.display = 'block';
        } else {
          emptyEl.classList.add('hidden');
          emptyEl.style.display = 'none';
        }
      }
    }

    window._applyPortfolioFilter = applyFilter;

    // Attach document-level click delegation once
    if (!window._portfolioFilterDelegationAdded) {
      window._portfolioFilterDelegationAdded = true;
      document.addEventListener('click', function(e) {
        var target = e.target;
        if (!target) return;
        var btn = target.closest('.portfolio-filter');
        if (btn) {
          var val = btn.getAttribute('data-filter') || 'all';
          if (typeof window._applyPortfolioFilter === 'function') {
            window._applyPortfolioFilter(val);
          }
        }
      });
    }

    // Initialize on page load and view transitions
    function init() {
      if (document.querySelector('.portfolio-filter')) {
        var activeBtn = document.querySelector('.portfolio-filter.active');
        var val = activeBtn ? activeBtn.getAttribute('data-filter') : 'all';
        applyFilter(val);
      }
    }

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
