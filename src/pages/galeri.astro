---
import Layout from '../layouts/Layout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

import { businessInfo } from '../data/business';

const galleryFaqs = [
  {
    question: 'Apakah seluruh dokumentasi di galeri adalah foto asli dari acara Halo Malang?',
    answer: 'Ya, 100% foto dan visual di galeri ini merupakan dokumentasi riil dari berbagai event yang kami kelola langsung di Malang Raya, Kota Wisata Batu, dan Kediri bersama tim produksi kami.'
  },
  {
    question: 'Bisakah instalasi dekorasi, stage, dan lighting disesuaikan dengan ukuran venue?',
    answer: 'Tentu. Tim teknis dan desainer 3D kami selalu melakukan pengukuran lokasi (technical survey) terlebih dahulu. Ukuran panggung, modular LED wall, rigging sound, dan komposisi bunga akan dihitung presisi agar proporsional dengan kapasitas dan layout venue Anda.'
  },
  {
    question: 'Berapa durasi waktu yang dibutuhkan tim Halo Malang untuk loading dan setup dekorasi?',
    answer: 'Durasi setup bervariasi sesuai kompleksitas: untuk acara meeting / intimate gathering membutuhkan waktu loading 4–8 jam, sedangkan untuk wedding megah, konser, atau stage custom skala besar membutuhkan loading H-1 (12–24 jam sebelumnya) dengan gladi bersih tuntas sebelum tamu hadir.'
  },
  {
    question: 'Bagaimana penanganan dekorasi dan lighting jika acara diadakan outdoor?',
    answer: 'Untuk venue outdoor di Malang atau Batu yang bersuhu sejuk atau berangin, kami menyiapkan konstruksi panggung berbobot aman (rigging ballast), pelindung cuaca (clear tent / tenda roder transparan jika diperlukan), serta electrical waterproof setup untuk keamanan maksimal.'
  }
];

const galleryItems = [
  {
    title: 'Modern Minimalist Sage Event Stage',
    category: 'panggung',
    location: 'Kota Malang',
    image: '/images/hero-stage.webp',
    tag: 'Stage & LED'
  },
  {
    title: 'East Java Corporate Innovation Forum',
    category: 'corporate',
    location: 'Grand Mercure Malang',
    image: '/images/corporate-malang.webp',
    tag: 'Corporate'
  },
  {
    title: 'Botanical Glasshouse Wedding Banquet',
    category: 'wedding',
    location: 'Batu Malang',
    image: '/images/wedding-reception.webp',
    tag: 'Wedding'
  },
  {
    title: 'Spectacular Night Festival Concert Rigging',
    category: 'panggung',
    location: 'Kota Kediri',
    image: '/images/stage-concert.webp',
    tag: 'Concert'
  },
  {
    title: 'Minimalist Eucalyptus & Hydrangea Floral Centerpiece',
    category: 'dekorasi',
    location: 'Malang Creative Center',
    image: '/images/floral-decor.webp',
    tag: 'Decor'
  },
  {
    title: 'Outdoor Mountain Resort Corporate Gathering',
    category: 'corporate',
    location: 'Kusuma Agrowisata Batu',
    image: '/images/gathering-batu.webp',
    tag: 'Gathering'
  },
  {
    title: 'Grand Ballroom Awarding Night & Gala Dinner',
    category: 'corporate',
    location: 'Grand Surya Hotel Kediri',
    image: '/images/kediri-gala.webp',
    tag: 'Gala Dinner'
  },
  {
    title: 'Executive Event Consultation & Briefing',
    category: 'corporate',
    location: 'Kantor Ijen Malang',
    image: '/images/client-portrait.webp',
    tag: 'Management'
  }
];
---

<Layout
  title="Galeri Dokumentasi Acara | Halo Malang Event Organizer"
  description="Koleksi foto visual stage lighting, dekorasi botanik, corporate gathering, dan pernikahan megah di Malang dan Kediri."
  currentPath="/galeri"
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Galeri', url: '/galeri' }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Header -->
    <div class="max-w-3xl mb-8">
      <span class="inline-block text-xs font-bold tracking-widest uppercase text-[#2d553b] bg-[#eaf2eb] px-3.5 py-1.5 rounded-full mb-3">
        Dokumentasi Visual Acara
      </span>
      <h1 class="text-3xl sm:text-4xl font-sans font-extrabold text-[#1b3825] leading-tight mb-3">
        Galeri Karya & Dokumentasi Acara
      </h1>
      <p class="text-xs sm:text-sm text-[#546b5a] leading-relaxed">
        Sentuhan estetika sage-minimalis, kehangatan tata cahaya, dan kemeriahan panggung produksi yang dihadirkan di berbagai penjuru Malang dan Kediri. Klik foto untuk melakukan inspect dan zoom detail dekorasi.
      </p>
    </div>

    <!-- Category Filter Bar -->
    <div class="flex items-center gap-2 mb-6 sm:mb-8 overflow-x-auto scrollbar-none pb-2 flex-nowrap sm:flex-wrap -mx-4 px-4 sm:mx-0 sm:px-0" id="gallery-filter-bar">
      <button
        type="button"
        class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-[#2d553b] text-white shadow-xs shrink-0 whitespace-nowrap"
        data-filter="all"
      >
        Semua Foto ({galleryItems.length})
      </button>
      <button
        type="button"
        class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-white text-[#415446] hover:bg-[#eaf1ec] border border-[#e1eae2] shrink-0 whitespace-nowrap"
        data-filter="panggung"
      >
        Stage & LED
      </button>
      <button
        type="button"
        class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-white text-[#415446] hover:bg-[#eaf1ec] border border-[#e1eae2] shrink-0 whitespace-nowrap"
        data-filter="corporate"
      >
        Corporate & Gathering
      </button>
      <button
        type="button"
        class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-white text-[#415446] hover:bg-[#eaf1ec] border border-[#e1eae2] shrink-0 whitespace-nowrap"
        data-filter="wedding"
      >
        Wedding
      </button>
      <button
        type="button"
        class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-white text-[#415446] hover:bg-[#eaf1ec] border border-[#e1eae2] shrink-0 whitespace-nowrap"
        data-filter="dekorasi"
      >
        Dekorasi & Florist
      </button>
    </div>

    <!-- Gallery Grid with Inspect Interaction -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="gallery-grid">
      {galleryItems.map((item, idx) => (
        <div 
          class="gallery-card group relative bg-white rounded-3xl overflow-hidden border border-[#e2ece4] shadow-xs cursor-pointer h-64 sm:h-72 focus:outline-none focus:ring-2 focus:ring-[#2d553b] focus:ring-offset-2 transition-all duration-300"
          role="button"
          tabindex="0"
          aria-label={`Inspeksi foto: ${item.title}`}
          data-index={idx}
          data-category={item.category}
          data-src={item.image}
          data-title={item.title}
          data-loc={item.location}
          data-tag={item.tag}
        >
          <img
            src={item.image}
            alt={item.title}
            class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-500"
            loading="lazy"
            width="400"
            height="500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent sm:opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-3.5 sm:p-4 text-white">
            <span class="text-[10px] uppercase font-bold text-emerald-300 mb-1">{item.tag} &bull; {item.location}</span>
            <h3 class="text-xs font-bold leading-snug line-clamp-2">{item.title}</h3>
            <span class="text-[10px] sm:text-[11px] text-emerald-200 font-semibold mt-2 flex items-center gap-1.5 bg-black/40 backdrop-blur-xs px-2.5 py-1 rounded-full w-fit border border-emerald-400/20">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
              Klik untuk Inspect & Zoom
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Enhanced Inspect Lightbox Modal -->
    <div
      id="lightbox-modal"
      role="dialog"
      aria-modal="true"
      aria-label="Inspeksi Foto Dokumentasi Acara"
      class="hidden fixed inset-0 z-[100] flex flex-col justify-between bg-black/95 backdrop-blur-md text-white select-none transition-opacity duration-200"
    >
      <!-- Dedicated Backdrop to cleanly catch outside clicks -->
      <div id="lightbox-backdrop" class="absolute inset-0 z-0 cursor-pointer" aria-hidden="true"></div>

      <!-- Top Toolbar -->
      <div class="relative z-10 flex items-center justify-between px-4 sm:px-6 py-3 bg-black/60 border-b border-white/10 backdrop-blur-sm">
        <div class="flex items-center gap-2 sm:gap-3">
          <span id="lightbox-counter" class="text-xs font-mono font-bold bg-white/15 px-2.5 py-1 rounded-full text-white">
            1 / {galleryItems.length}
          </span>
          <span id="lightbox-tag" class="text-[11px] font-bold text-emerald-300 uppercase tracking-wider bg-emerald-950/80 border border-emerald-500/30 px-2.5 py-0.5 rounded-full">
            Stage & LED
          </span>
          <span id="lightbox-loc" class="text-xs text-gray-300 hidden sm:inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span id="lightbox-loc-text">Kota Malang</span>
          </span>
        </div>

        <!-- Zoom & View Controls -->
        <div class="flex items-center gap-1.5 sm:gap-2">
          <!-- Zoom Out -->
          <button
            id="lightbox-zoom-out"
            type="button"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 active:scale-95 text-white flex items-center justify-center transition-all cursor-pointer"
            aria-label="Perkecil zoom"
            title="Zoom Out (-)"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
            </svg>
          </button>

          <!-- Zoom Reset / Current Indicator -->
          <button
            id="lightbox-zoom-reset"
            type="button"
            class="px-2.5 h-9 rounded-full bg-white/10 hover:bg-white/20 active:scale-95 text-white font-mono text-xs font-bold flex items-center justify-center transition-all cursor-pointer"
            aria-label="Reset zoom ke 100%"
            title="Reset Zoom (0)"
          >
            100%
          </button>

          <!-- Zoom In -->
          <button
            id="lightbox-zoom-in"
            type="button"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 active:scale-95 text-white flex items-center justify-center transition-all cursor-pointer"
            aria-label="Perbesar zoom"
            title="Zoom In (+)"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </button>

          <!-- Fullscreen Toggle -->
          <button
            id="lightbox-fullscreen"
            type="button"
            class="hidden sm:flex w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 active:scale-95 text-white items-center justify-center transition-all cursor-pointer"
            aria-label="Mode layar penuh"
            title="Layar Penuh (F)"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
            </svg>
          </button>

          <!-- Close Modal -->
          <button
            id="lightbox-close"
            type="button"
            class="w-9 h-9 rounded-full bg-white/15 hover:bg-red-500/80 active:scale-95 text-white flex items-center justify-center transition-all cursor-pointer ml-1"
            aria-label="Tutup inspeksi foto"
            title="Tutup (Esc)"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Main Stage Viewport -->
      <div class="relative z-10 flex-1 flex items-center justify-center overflow-hidden p-2 sm:p-4">
        <!-- Prev Button -->
        <button
          id="lightbox-prev"
          type="button"
          class="absolute left-2 sm:left-6 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-black/60 hover:bg-[#2d553b] text-white border border-white/20 backdrop-blur-sm flex items-center justify-center transition-all shadow-xl hover:scale-105 active:scale-95 cursor-pointer"
          aria-label="Foto sebelumnya"
          title="Sebelumnya (Panah Kiri)"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <!-- Next Button -->
        <button
          id="lightbox-next"
          type="button"
          class="absolute right-2 sm:right-6 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-black/60 hover:bg-[#2d553b] text-white border border-white/20 backdrop-blur-sm flex items-center justify-center transition-all shadow-xl hover:scale-105 active:scale-95 cursor-pointer"
          aria-label="Foto selanjutnya"
          title="Selanjutnya (Panah Kanan)"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Image Container with Zoom & Pan Support -->
        <div
          id="lightbox-viewport"
          class="relative max-w-full max-h-full flex items-center justify-center overflow-hidden touch-none"
        >
          <img
            id="lightbox-img"
            src=""
            alt="Detail foto"
            class="max-h-[66vh] sm:max-h-[74vh] max-w-[86vw] sm:max-w-[82vw] object-contain rounded-xl shadow-2xl transition-transform duration-100 select-none cursor-zoom-in"
            draggable="false"
          />
        </div>
      </div>

      <!-- Bottom Info Bar -->
      <div class="relative z-10 px-4 sm:px-6 py-3 bg-black/60 border-t border-white/10 backdrop-blur-sm flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
        <div class="max-w-xl">
          <h3 id="lightbox-title" class="text-sm sm:text-base font-bold text-white leading-tight"></h3>
          <p class="text-[11px] text-gray-400 mt-1 hidden md:block">
            <span>💡 <strong>Tips Inspect:</strong> Double-click atau scroll mouse untuk zoom &bull; Drag untuk menggeser &bull; [← / →] Ganti foto &bull; [Esc] Tutup</span>
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a
            id="lightbox-wa-btn"
            href={`https://wa.me/${businessInfo.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#25D366] hover:bg-[#20ba59] active:scale-95 text-white text-xs font-bold transition-all shadow-md"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z" />
            </svg>
            <span>Konsultasi Konsep Ini</span>
          </a>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="mt-16 pt-10 border-t border-[#e2ece4]">
      <FAQAccordion
        faqs={galleryFaqs}
        title="Pertanyaan Seputar Galeri & Dekorasi Acara"
        subtitle="Pertanyaan seputar spesifikasi panggung, instalasi dekorasi, loading venue, dan adaptasi outdoor."
      />
    </div>

  </div>
</Layout>

<script is:inline>
  (function () {
    const WHATSAPP_NUM = '6288989643555';
    let currentFilteredCards = [];
    let currentIndex = 0;
    let zoomLevel = 1;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;
    let lastTapTime = 0;

    function getElements() {
      return {
        modal: document.getElementById('lightbox-modal'),
        backdrop: document.getElementById('lightbox-backdrop'),
        img: document.getElementById('lightbox-img'),
        viewport: document.getElementById('lightbox-viewport'),
        title: document.getElementById('lightbox-title'),
        locText: document.getElementById('lightbox-loc-text'),
        tag: document.getElementById('lightbox-tag'),
        counter: document.getElementById('lightbox-counter'),
        closeBtn: document.getElementById('lightbox-close'),
        prevBtn: document.getElementById('lightbox-prev'),
        nextBtn: document.getElementById('lightbox-next'),
        zoomInBtn: document.getElementById('lightbox-zoom-in'),
        zoomOutBtn: document.getElementById('lightbox-zoom-out'),
        zoomResetBtn: document.getElementById('lightbox-zoom-reset'),
        fullscreenBtn: document.getElementById('lightbox-fullscreen'),
        waBtn: document.getElementById('lightbox-wa-btn')
      };
    }

    function applyZoomTransform() {
      const { img, zoomResetBtn } = getElements();
      if (!img) return;

      img.style.transform = 'translate(' + panX + 'px, ' + panY + 'px) scale(' + zoomLevel + ')';

      if (zoomResetBtn) {
        zoomResetBtn.textContent = Math.round(zoomLevel * 100) + '%';
      }

      if (zoomLevel > 1) {
        img.classList.remove('cursor-zoom-in');
        img.classList.add(isDragging ? 'cursor-grabbing' : 'cursor-grab');
      } else {
        img.classList.remove('cursor-grab', 'cursor-grabbing');
        img.classList.add('cursor-zoom-in');
      }
    }

    function setZoom(newZoom) {
      zoomLevel = Math.max(1, Math.min(3, Math.round(newZoom * 10) / 10));
      if (zoomLevel === 1) {
        panX = 0;
        panY = 0;
      }
      applyZoomTransform();
    }

    function resetZoom() {
      zoomLevel = 1;
      panX = 0;
      panY = 0;
      applyZoomTransform();
    }

    function toggleZoom() {
      if (zoomLevel === 1) {
        setZoom(2);
      } else {
        resetZoom();
      }
    }

    function updateModalContent() {
      const els = getElements();
      if (!els.modal || currentFilteredCards.length === 0) return;

      const card = currentFilteredCards[currentIndex];
      if (!card) return;

      const src = card.getAttribute('data-src') || '';
      const title = card.getAttribute('data-title') || '';
      const loc = card.getAttribute('data-loc') || '';
      const tag = card.getAttribute('data-tag') || '';

      if (els.img) {
        els.img.src = src;
        els.img.alt = title;
      }
      if (els.title) els.title.textContent = title;
      if (els.locText) els.locText.textContent = loc;
      if (els.tag) els.tag.textContent = tag;
      if (els.counter) {
        els.counter.textContent = (currentIndex + 1) + ' / ' + currentFilteredCards.length;
      }

      if (els.waBtn) {
        const text = 'Halo Halo Malang, saya tertarik dengan konsep "' + encodeURIComponent(title) + '" di galeri dokumentasi. Bisa konsultasi untuk kebutuhan acara kami?';
        els.waBtn.href = 'https://wa.me/' + WHATSAPP_NUM + '?text=' + text;
      }

      resetZoom();

      // Preload next and prev images
      if (currentFilteredCards.length > 1) {
        const nextIdx = (currentIndex + 1) % currentFilteredCards.length;
        const prevIdx = (currentIndex - 1 + currentFilteredCards.length) % currentFilteredCards.length;
        const nextSrc = currentFilteredCards[nextIdx]?.getAttribute('data-src');
        const prevSrc = currentFilteredCards[prevIdx]?.getAttribute('data-src');
        if (nextSrc) { const p = new Image(); p.src = nextSrc; }
        if (prevSrc) { const p = new Image(); p.src = prevSrc; }
      }
    }

    function openLightbox(index) {
      const els = getElements();
      if (!els.modal) return;

      currentIndex = Math.max(0, Math.min(index, currentFilteredCards.length - 1));
      updateModalContent();
      els.modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      const els = getElements();
      if (!els.modal) return;

      els.modal.classList.add('hidden');
      document.body.style.overflow = '';
      resetZoom();

      if (document.fullscreenElement) {
        document.exitFullscreen().catch(function() {});
      }
    }

    function showNext() {
      if (currentFilteredCards.length <= 1) return;
      currentIndex = (currentIndex + 1) % currentFilteredCards.length;
      updateModalContent();
    }

    function showPrev() {
      if (currentFilteredCards.length <= 1) return;
      currentIndex = (currentIndex - 1 + currentFilteredCards.length) % currentFilteredCards.length;
      updateModalContent();
    }

    function filterGallery(filterVal) {
      if (!filterVal) filterVal = 'all';

      // Update button styling
      const filterBtns = document.querySelectorAll('.gallery-filter-btn');
      filterBtns.forEach(function (btn) {
        const bVal = btn.getAttribute('data-filter');
        if (bVal === filterVal) {
          btn.classList.remove('bg-white', 'text-[#415446]', 'hover:bg-[#eaf1ec]', 'border-[#e1eae2]');
          btn.classList.add('bg-[#2d553b]', 'text-white', 'shadow-xs');
        } else {
          btn.classList.remove('bg-[#2d553b]', 'text-white', 'shadow-xs');
          btn.classList.add('bg-white', 'text-[#415446]', 'hover:bg-[#eaf1ec]', 'border', 'border-[#e1eae2]');
        }
      });

      // Filter gallery cards
      const allCards = document.querySelectorAll('.gallery-card');
      currentFilteredCards = [];

      allCards.forEach(function (card) {
        const cat = card.getAttribute('data-category') || '';
        if (filterVal === 'all' || cat === filterVal) {
          card.style.display = 'block';
          currentFilteredCards.push(card);
        } else {
          card.style.display = 'none';
        }
      });
    }

    function initGallery() {
      const els = getElements();
      if (!els.modal) return;

      filterGallery('all');

      // Click card to open modal
      const allCards = document.querySelectorAll('.gallery-card');
      allCards.forEach(function (card) {
        card.onclick = function () {
          const idxInFiltered = currentFilteredCards.indexOf(card);
          openLightbox(idxInFiltered >= 0 ? idxInFiltered : 0);
        };
        card.onkeydown = function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const idxInFiltered = currentFilteredCards.indexOf(card);
            openLightbox(idxInFiltered >= 0 ? idxInFiltered : 0);
          }
        };
      });

      // Filter button click handlers
      const filterBtns = document.querySelectorAll('.gallery-filter-btn');
      filterBtns.forEach(function (btn) {
        btn.onclick = function () {
          const f = btn.getAttribute('data-filter') || 'all';
          filterGallery(f);
        };
      });

      // Backdrop & Close button
      if (els.backdrop) els.backdrop.onclick = closeLightbox;
      if (els.closeBtn) els.closeBtn.onclick = closeLightbox;

      // Next & Prev buttons
      if (els.nextBtn) els.nextBtn.onclick = showNext;
      if (els.prevBtn) els.prevBtn.onclick = showPrev;

      // Zoom In, Out, Reset
      if (els.zoomInBtn) {
        els.zoomInBtn.onclick = function () { setZoom(zoomLevel + 0.5); };
      }
      if (els.zoomOutBtn) {
        els.zoomOutBtn.onclick = function () { setZoom(zoomLevel - 0.5); };
      }
      if (els.zoomResetBtn) {
        els.zoomResetBtn.onclick = resetZoom;
      }

      // Fullscreen
      if (els.fullscreenBtn) {
        els.fullscreenBtn.onclick = function () {
          if (!document.fullscreenElement) {
            els.modal.requestFullscreen().catch(function () {});
          } else {
            document.exitFullscreen().catch(function () {});
          }
        };
      }

      // Double-click image to toggle zoom
      if (els.img) {
        els.img.ondblclick = function (e) {
          e.preventDefault();
          toggleZoom();
        };
      }

      // Mouse wheel zoom
      if (els.viewport) {
        els.viewport.onwheel = function (e) {
          e.preventDefault();
          if (e.deltaY < 0) {
            setZoom(zoomLevel + 0.25);
          } else {
            setZoom(zoomLevel - 0.25);
          }
        };

        // Mouse drag pan when zoomed
        els.viewport.onmousedown = function (e) {
          if (zoomLevel <= 1) return;
          isDragging = true;
          dragStartX = e.clientX - panX;
          dragStartY = e.clientY - panY;
          applyZoomTransform();
        };

        window.onmousemove = function (e) {
          if (!isDragging) return;
          panX = e.clientX - dragStartX;
          panY = e.clientY - dragStartY;
          applyZoomTransform();
        };

        window.onmouseup = function () {
          if (isDragging) {
            isDragging = false;
            applyZoomTransform();
          }
        };

        // Touch gestures (swipe or pan)
        els.viewport.ontouchstart = function (e) {
          if (e.touches.length === 1) {
            const touch = e.touches[0];
            touchStartX = touch.clientX;
            touchStartY = touch.clientY;
            touchEndX = touch.clientX;
            touchEndY = touch.clientY;

            if (zoomLevel > 1) {
              isDragging = true;
              dragStartX = touch.clientX - panX;
              dragStartY = touch.clientY - panY;
            }

            // Double tap detection
            const now = Date.now();
            if (now - lastTapTime < 300) {
              e.preventDefault();
              toggleZoom();
            }
            lastTapTime = now;
          }
        };

        els.viewport.ontouchmove = function (e) {
          if (e.touches.length === 1) {
            const touch = e.touches[0];
            touchEndX = touch.clientX;
            touchEndY = touch.clientY;

            if (isDragging && zoomLevel > 1) {
              e.preventDefault();
              panX = touch.clientX - dragStartX;
              panY = touch.clientY - dragStartY;
              applyZoomTransform();
            }
          }
        };

        els.viewport.ontouchend = function () {
          if (isDragging) {
            isDragging = false;
          }

          // Horizontal swipe when not zoomed
          if (zoomLevel === 1) {
            const diffX = touchEndX - touchStartX;
            const diffY = touchEndY - touchStartY;
            if (Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY)) {
              if (diffX < 0) {
                showNext();
              } else {
                showPrev();
              }
            }
          }
        };
      }
    }

    // Keyboard navigation
    document.addEventListener('keydown', function (e) {
      const modal = document.getElementById('lightbox-modal');
      if (!modal || modal.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeLightbox();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        showNext();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        showPrev();
      } else if (e.key === '+' || e.key === '=') {
        e.preventDefault();
        setZoom(zoomLevel + 0.5);
      } else if (e.key === '-' || e.key === '_') {
        e.preventDefault();
        setZoom(zoomLevel - 0.5);
      } else if (e.key === '0') {
        e.preventDefault();
        resetZoom();
      }
    });

    // Run on first load and on Astro navigation
    initGallery();
    document.addEventListener('astro:page-load', initGallery);
  })();
</script>

