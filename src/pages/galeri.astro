---
import Layout from '../layouts/Layout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const galleryFaqs = [
  {
    question: 'Apakah seluruh dokumentasi di galeri adalah foto asli dari acara Aethel?',
    answer: 'Ya, 100% foto dan visual di galeri ini merupakan dokumentasi riil dari berbagai event yang kami kelola langsung di Malang Raya, Kota Wisata Batu, dan Kediri bersama tim produksi kami.'
  },
  {
    question: 'Bisakah instalasi dekorasi, stage, dan lighting disesuaikan dengan ukuran venue?',
    answer: 'Tentu. Tim teknis dan desainer 3D kami selalu melakukan pengukuran lokasi (technical survey) terlebih dahulu. Ukuran panggung, modular LED wall, rigging sound, dan komposisi bunga akan dihitung presisi agar proporsional dengan kapasitas dan layout venue Anda.'
  },
  {
    question: 'Berapa durasi waktu yang dibutuhkan tim Aethel untuk loading dan setup dekorasi?',
    answer: 'Durasi setup bervariasi sesuai kompleksitas: untuk acara meeting / intimate gathering membutuhkan waktu loading 4–8 jam, sedangkan untuk wedding megah, konser, atau stage custom skala besar membutuhkan loading H-1 (12–24 jam sebelumnya) dengan gladi bersih tuntas sebelum tamu hadir.'
  },
  {
    question: 'Bagaimana penanganan dekorasi dan lighting jika acara diadakan outdoor?',
    answer: 'Untuk venue outdoor di Malang atau Batu yang bersuhu sejuk atau berangin, kami menyiapkan konstruksi panggung berbobot aman (rigging ballast), pelindung cuaca (clear tent / tenda roder transparan jika diperlukan), serta electrical waterproof setup untuk keamanan maksimal.'
  }
];

const galleryItems = [
  {
    title: 'Modern Minimalist Sage Event Stage',
    category: 'panggung',
    location: 'Kota Malang',
    image: '/images/hero-stage.webp',
    tag: 'Stage & LED'
  },
  {
    title: 'East Java Corporate Innovation Forum',
    category: 'corporate',
    location: 'Grand Mercure Malang',
    image: '/images/corporate-malang.webp',
    tag: 'Corporate'
  },
  {
    title: 'Botanical Glasshouse Wedding Banquet',
    category: 'wedding',
    location: 'Batu Malang',
    image: '/images/wedding-reception.webp',
    tag: 'Wedding'
  },
  {
    title: 'Spectacular Night Festival Concert Rigging',
    category: 'panggung',
    location: 'Kota Kediri',
    image: '/images/stage-concert.webp',
    tag: 'Concert'
  },
  {
    title: 'Minimalist Eucalyptus & Hydrangea Floral Centerpiece',
    category: 'dekorasi',
    location: 'Malang Creative Center',
    image: '/images/floral-decor.webp',
    tag: 'Decor'
  },
  {
    title: 'Outdoor Mountain Resort Corporate Gathering',
    category: 'corporate',
    location: 'Kusuma Agrowisata Batu',
    image: '/images/gathering-batu.webp',
    tag: 'Gathering'
  },
  {
    title: 'Grand Ballroom Awarding Night & Gala Dinner',
    category: 'corporate',
    location: 'Grand Surya Hotel Kediri',
    image: '/images/kediri-gala.webp',
    tag: 'Gala Dinner'
  },
  {
    title: 'Executive Event Consultation & Briefing',
    category: 'corporate',
    location: 'Kantor Ijen Malang',
    image: '/images/client-portrait.webp',
    tag: 'Management'
  }
];
---

<Layout
  title="Galeri Dokumentasi Acara | Aethel Event Organizer"
  description="Koleksi foto visual stage lighting, dekorasi botanik, corporate gathering, dan pernikahan megah di Malang dan Kediri."
  currentPath="/galeri"
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Galeri', url: '/galeri' }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Header -->
    <div class="max-w-3xl mb-8">
      <h1 class="text-3xl sm:text-4xl font-sans font-extrabold text-[#1b3825] leading-tight mb-3">
        Galeri Karya & Dokumentasi Acara
      </h1>
      <p class="text-xs sm:text-sm text-[#546b5a] leading-relaxed">
        Sentuhan estetika sage-minimalis, kehangatan tata cahaya, dan kemeriahan panggung produksi yang dihadirkan di berbagai penjuru Malang dan Kediri.
      </p>
    </div>

    <!-- Gallery Grid with Lightbox Interaction -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="gallery-grid">
      {galleryItems.map((item, idx) => (
        <div 
          class="gallery-card group relative bg-white rounded-3xl overflow-hidden border border-[#e2ece4] shadow-xs cursor-pointer h-64 sm:h-72"
          data-src={item.image}
          data-title={item.title}
          data-loc={item.location}
        >
          <img
            src={item.image}
            alt={item.title}
            class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4 text-white">
            <span class="text-[10px] uppercase font-bold text-emerald-300 mb-1">{item.tag} &bull; {item.location}</span>
            <h3 class="text-xs font-bold leading-snug">{item.title}</h3>
            <span class="text-[10px] text-gray-300 mt-2 flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
              Klik untuk perbesar
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Simple Lightbox Modal -->
    <div id="lightbox-modal" class="hidden fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4">
      <button id="lightbox-close" class="absolute top-6 right-6 text-white text-3xl font-bold hover:text-emerald-300 cursor-pointer">&times;</button>
      <div class="max-w-4xl w-full text-center">
        <img id="lightbox-img" src="" alt="Perbesar" class="max-h-[80vh] mx-auto rounded-2xl shadow-2xl mb-4 object-contain" />
        <h4 id="lightbox-title" class="text-white text-sm font-bold"></h4>
        <p id="lightbox-loc" class="text-xs text-emerald-300 mt-1"></p>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="mt-16 pt-10 border-t border-[#e2ece4]">
      <FAQAccordion
        faqs={galleryFaqs}
        title="Pertanyaan Seputar Galeri & Dekorasi Acara"
        subtitle="Pertanyaan seputar spesifikasi panggung, instalasi dekorasi, loading venue, dan adaptasi outdoor."
      />
    </div>

  </div>
</Layout>

<script>
  function setupGalleryLightbox() {
    const cards = document.querySelectorAll('.gallery-card');
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img');
    const modalTitle = document.getElementById('lightbox-title');
    const modalLoc = document.getElementById('lightbox-loc');
    const closeBtn = document.getElementById('lightbox-close');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const src = card.getAttribute('data-src') || '';
        const title = card.getAttribute('data-title') || '';
        const loc = card.getAttribute('data-loc') || '';

        if (modalImg) modalImg.src = src;
        if (modalTitle) modalTitle.innerText = title;
        if (modalLoc) modalLoc.innerText = loc;
        modal?.classList.remove('hidden');
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });
  }

  setupGalleryLightbox();
  document.addEventListener('astro:page-load', setupGalleryLightbox);
</script>
