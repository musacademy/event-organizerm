---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { portfolioData } from '../data/portfolio';
import { blogPosts } from '../data/blog';

const kediriPortfolio = portfolioData.filter((p) => p.city === 'kediri');
const kediriPosts = blogPosts.filter((p) => p.cityTag === 'Kediri');

const kediriFaqs = [
  {
    question: 'Di mana basis operasional Aethel Event di Kediri?',
    answer: 'Kami memiliki hub operasional logistik dan kantor representatif di Jl. Dhoho No. 88, Kota Kediri. Hal ini memudahkan mobilitas peralatan panggung, sound system, serta koordinasi tatap muka langsung dengan klien di Kediri.'
  },
  {
    question: 'Apakah Aethel melayani event korporat pabrik / manufaktur di Kediri?',
    answer: 'Tentu. Kediri merupakan salah satu pusat industri manufaktur, tembakau, dan agrobisnis terpenting di Jawa Timur. Kami berpengalaman mengelola employee gathering skala ribuan, safety day, peresmian fasilitas pabrik baru, hingga malam apresiasi tahunan.'
  },
  {
    question: 'Bagaimana koordinasi perizinan acara outdoor di kawasan Simpang Lima Gumul (SLG)?',
    answer: 'Kawasan SLG memerlukan perizinan dari pemerintah daerah dan kepolisian setempat. Tim Aethel secara rutin berkoordinasi dengan dinas terkait untuk pengurusan izin keramaian, rekayasa lalu lintas penonton, serta zonasi tenant bazar.'
  },
  {
    question: 'Apakah tersedia penyewaan LED screen modular dan tata suara di Kediri tanpa biaya kirim luar kota?',
    answer: 'Ya, perlengkapan LED p3.9 indoor/outdoor, tata lampu moving beam, dan sound system line-array kami siap dimobilisasi dari hub Kediri sehingga menghemat biaya logistik transportasi Anda.'
  }
];
---

<Layout
  title="Event Organizer Kediri | Jasa EO Profesional"
  description="Cari jasa Event Organizer di Kediri? Diskusikan konsep, kebutuhan, dan rencana acara Anda bersama tim kami."
  keywords="Event Organizer Kediri, Jasa Event Organizer Kediri, EO Kediri, Jasa EO di Kediri, Event Organizer Kediri untuk perusahaan, Jasa penyelenggara acara Kediri"
  currentPath="/event-organizer-kediri"
  citySpecific="kediri"
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Event Organizer Kediri', url: '/event-organizer-kediri' }
  ]}
>
  <!-- Hero Section Kediri -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-8">
    <div class="relative bg-white rounded-[2rem] sm:rounded-[2.75rem] border border-[#e2ece4] overflow-hidden shadow-sm p-3 sm:p-5">
      <div class="relative w-full h-[460px] sm:h-[520px] rounded-[1.75rem] sm:rounded-[2.25rem] overflow-hidden">
        <img
          src="/images/kediri-gala.jpg"
          alt="Event Organizer Kediri - Corporate Awarding dan Gala Dinner"
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#13271a]/95 via-[#1a3825]/60 to-black/30"></div>

        <div class="absolute inset-0 p-6 sm:p-12 lg:p-16 flex flex-col justify-end max-w-2xl text-white">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#387049]/90 border border-white/20 text-xs font-semibold tracking-wide text-emerald-100 backdrop-blur-md mb-4 w-fit">
            <span class="w-2 h-2 rounded-full bg-emerald-300"></span>
            <span>Hub Operasional: Jl. Dhoho No. 88, Kota Kediri</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold font-sans tracking-tight leading-tight mb-4 text-white">
            Event Organizer Kediri untuk Perusahaan & Acara Spesial.
          </h1>

          <p class="text-xs sm:text-sm text-[#d8ebd9] font-normal leading-relaxed mb-6 max-w-lg">
            Diskusikan konsep, kebutuhan teknis, dan rencana acara Anda bersama tim Event Organizer profesional kami untuk mewujudkan eksekusi acara terbaik di Kediri.
          </p>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="#konsultasi-kediri"
              class="px-6 py-3 rounded-full bg-[#2d553b] hover:bg-[#1a3825] text-white text-xs sm:text-sm font-semibold transition-all shadow-md border border-emerald-400/30"
            >
              Konsultasi Acara di Kediri
            </a>
            <a
              href="/event-organizer-malang"
              class="px-5 py-3 rounded-full bg-white/90 hover:bg-white text-[#1b3825] text-xs font-semibold transition-all"
            >
              Lihat Layanan Malang &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Explanation & Scope of Services in Kediri -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7">
        <span class="text-xs font-bold tracking-widest uppercase text-[#3f724f] bg-[#eaf2eb] px-3.5 py-1.5 rounded-full inline-block mb-3">
          Layanan Spesifik Wilayah Kediri
        </span>
        <h2 class="text-2xl sm:text-3xl font-sans font-extrabold text-[#1b3825] leading-tight mb-4">
          Mendukung Kemajuan Bisnis & Momen Istimewa di Kota & Kabupaten Kediri
        </h2>
        <div class="space-y-3 text-xs sm:text-sm text-[#4e6654] leading-relaxed">
          <p>
            Kediri tengah bertransformasi pesat dengan kehadiran Bandara Internasional Dhoho Kediri serta akselerasi koridor ekonomi Mataraman. Kebutuhan industri, korporasi perbankan, manufaktur, dan institusi pemerintahan akan penyelenggaraan acara berkualitas semakin mendesak.
          </p>
          <p>
            Aethel Event hadir dengan hub operasional di kawasan sentra bisnis Jl. Dhoho Kediri. Kami menyediakan layanan komprehensif mulai dari rancangan panggung ballroom di hotel terkemuka seperti Grand Surya Kediri, perizinan dan crowd control konser terbuka di Simpang Lima Gumul (SLG), hingga private gala dinner eksklusif.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-6">
          <div class="bg-white p-3 rounded-2xl border border-[#e2ece4] text-center">
            <span class="block text-lg font-bold text-[#2d553b]">45+</span>
            <span class="text-[11px] text-[#607966]">Event Sukses di Kediri</span>
          </div>
          <div class="bg-white p-3 rounded-2xl border border-[#e2ece4] text-center">
            <span class="block text-lg font-bold text-[#2d553b]">Line Array</span>
            <span class="text-[11px] text-[#607966]">Sound Hub Lokal Kediri</span>
          </div>
          <div class="bg-white p-3 rounded-2xl border border-[#e2ece4] text-center col-span-2 sm:col-span-1">
            <span class="block text-lg font-bold text-[#2d553b]">Respon 24 Jam</span>
            <span class="text-[11px] text-[#607966]">Konsultasi Cepat</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 grid grid-cols-2 gap-3">
        <div class="rounded-3xl overflow-hidden border border-[#e2ece4] h-52 sm:h-64 shadow-xs">
          <img src="/images/stage-concert.jpg" alt="Festival panggung konser di Kediri" class="w-full h-full object-cover" />
        </div>
        <div class="rounded-3xl overflow-hidden border border-[#e2ece4] h-52 sm:h-64 shadow-xs translate-y-3">
          <img src="/images/wedding-reception.jpg" alt="Resepsi pernikahan di Kediri" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Jenis Acara yang Ditangani di Kediri -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-[#edf4ee] rounded-[2.5rem] p-6 sm:p-10 border border-[#d6e5d9]">
      <div class="max-w-2xl mb-8">
        <h3 class="text-xl sm:text-2xl font-sans font-extrabold text-[#1b3825] mb-2">
          Jenis Acara yang Kami Kelola di Kediri
        </h3>
        <p class="text-xs sm:text-sm text-[#546e5a]">
          Kombinasi tim teknis berpengalaman dan inventaris peralatan modern untuk hasil maksimal.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-3xl border border-[#dce8df]">
          <div class="w-10 h-10 rounded-2xl bg-[#e3efe5] flex items-center justify-center text-[#2d553b] mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
            </svg>
          </div>
          <h4 class="text-sm font-bold text-[#1b3825] mb-1">Corporate Awards & Gala Dinner</h4>
          <p class="text-xs text-[#526a58] leading-relaxed">
            Malam apresiasi korporasi dengan lighting mewah, pembawa acara profesional, dan hiburan orkestra.
          </p>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-[#dce8df]">
          <div class="w-10 h-10 rounded-2xl bg-[#e3efe5] flex items-center justify-center text-[#2d553b] mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h4 class="text-sm font-bold text-[#1b3825] mb-1">Gathering Karyawan & Pabrik</h4>
          <p class="text-xs text-[#526a58] leading-relaxed">
            Manajemen acara ribuan karyawan dengan alur konsumsi tertib, panggung hiburan, dan doorprize seru.
          </p>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-[#dce8df]">
          <div class="w-10 h-10 rounded-2xl bg-[#e3efe5] flex items-center justify-center text-[#2d553b] mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
            </svg>
          </div>
          <h4 class="text-sm font-bold text-[#1b3825] mb-1">Festival Musik & Expo SLG</h4>
          <p class="text-xs text-[#526a58] leading-relaxed">
            Penataan panggung outdoor, rigging truss, tata lampu moving beam, dan manajemen arus penonton tertib.
          </p>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-[#dce8df]">
          <div class="w-10 h-10 rounded-2xl bg-[#e3efe5] flex items-center justify-center text-[#2d553b] mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.701 2.701 0 00-1.5-.454M9 6v2m3-2v2m3-2v2M9 3h.01M12 3h.01M15 3h.01M21 21v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v7h18zm-3-9v-2a2 2 0 00-2-2H8a2 2 0 00-2 2v2h10z" />
            </svg>
          </div>
          <h4 class="text-sm font-bold text-[#1b3825] mb-1">Wedding Organizer Kediri</h4>
          <p class="text-xs text-[#526a58] leading-relaxed">
            Penyelenggaraan resepsi pernikahan di ballroom termegah Kediri dengan dekorasi custom dan pendampingan keluarga.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Portofolio Khusus Kediri -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h3 class="text-xl sm:text-2xl font-sans font-extrabold text-[#1b3825]">
          Portofolio Proyek Acara di Kediri
        </h3>
        <p class="text-xs text-[#526a58] mt-1">Dokumentasi nyata kegiatan yang telah dipercayakan kepada Aethel Events.</p>
      </div>
      <a href="/portofolio" class="text-xs font-bold text-[#2d553b] hover:underline">Semua Portofolio &rarr;</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {kediriPortfolio.map((item) => (
        <div class="bg-white rounded-3xl overflow-hidden border border-[#e2ece4] shadow-xs group flex flex-col justify-between">
          <div>
            <div class="relative w-full h-56 overflow-hidden bg-gray-100">
              <img src={item.featuredImage} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <span class="absolute top-3 left-3 px-3 py-1 bg-[#2d553b] text-white text-[10px] font-bold rounded-full">
                {item.category}
              </span>
            </div>
            <div class="p-6">
              <span class="text-[11px] text-[#55755d] font-semibold block mb-1">{item.location}</span>
              <h4 class="text-base font-bold text-[#1b3825] line-clamp-1 mb-2">{item.title}</h4>
              <p class="text-xs text-[#526a58] leading-relaxed mb-4">{item.description}</p>
              
              <div class="flex flex-wrap gap-1.5 mb-2">
                {item.servicesProvided.slice(0, 3).map((svc) => (
                  <span class="text-[10px] bg-[#edf4ee] text-[#2d553b] px-2 py-0.5 rounded-md font-medium">
                    {svc}
                  </span>
                ))}
              </div>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href={`/portofolio/${item.slug}`} class="text-xs font-bold text-[#2d553b] hover:underline inline-flex items-center gap-1">
              <span>Detail Proyek & Testimoni Klien</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ Khusus Kediri -->
  <FAQAccordion
    faqs={kediriFaqs}
    title="FAQ Seputar Event Organizer Kediri"
    subtitle="Pertanyaan umum seputar layanan EO di Kota dan Kabupaten Kediri."
  />

  <!-- Form Pengajuan Acara Kediri -->
  <div id="konsultasi-kediri">
    <ContactForm
      defaultLocation="Kediri"
      headline="Konsultasi & Pengajuan Acara di Kediri"
      subheadline="Dapatkan rancangan proposal dan simulasi anggaran khusus untuk acara Anda di wilayah Kediri."
    />
  </div>

  <!-- Internal Link to Malang -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 text-center">
    <div class="bg-white rounded-2xl p-6 border border-[#e2ece4] inline-block max-w-xl">
      <span class="text-xs text-[#526a58]">Mencari referensi penyelenggaraan acara di Malang Raya & Batu?</span>
      <div class="mt-2">
        <a href="/event-organizer-malang" class="text-xs font-bold text-[#2d553b] hover:underline">
          Kunjungi Halaman Layanan Event Organizer Malang &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
